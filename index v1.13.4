                            '--text-primary': '51 40 34', '--text-secondary': '84 70 60',
                            '--primary': '166 124 82', '--primary-soft': '234 223 209',
                            '--primary-dark': '131 95 60', '--accent': '201 154 62',
                            '--border': '230 218 203', '--shadow-tint': '166 124 82'
                        },
                        fonts: { heading: "'Lora', serif", body: "'Source Sans 3', sans-serif" },
                        swatches: ['#FAF6F0', '#A67C52', '#835F3C', '#C99A3E'],
                        googleFonts: 'Lora:wght@400;600;700&family=Source+Sans+3:wght@400;500;600;700'
                    }
                },

                // Legacy names -> real theme keys (backward-compatible).
                _aliases: {
                    blush: 'aurora_blush',
                    sage: 'sage_harmony',
                    lavender: 'amethyst_mist'
                },

                // Resolve the stored theme name to a real palette key.
                current: function () {
                    let name = (appData.settings && appData.settings.theme) || 'aurora_blush';
                    if (this._aliases[name]) name = this._aliases[name];
                    return this.palettes[name] ? name : 'aurora_blush';
                },

                // Lazy-load a theme's Google Fonts once (unique <link> id).
                _loadFont: function (key) {
                    const pal = this.palettes[key];
                    if (!pal || !pal.googleFonts) return;
                    const id = 'theme-font-' + key;
                    if (document.getElementById(id)) return; // already loaded
                    try {
                        const link = document.createElement('link');
                        link.id = id;
                        link.rel = 'stylesheet';
                        link.href = 'https://fonts.googleapis.com/css2?family=' + pal.googleFonts + '&display=swap';
                        document.head.appendChild(link);
                    } catch (e) { /* keep existing fonts as fallback */ }
                },

                // Publish all semantic tokens + fonts on :root for the active
                // theme. Live — no reload.
                applyToRoot: function () {
                    const name = this.current();
                    const pal = this.palettes[name];
                    if (!pal) return;
                    const root = document.documentElement;
                    // Colour tokens
                    this._tokenKeys.forEach(function (k) {
                        if (pal.tokens[k]) root.style.setProperty(k, pal.tokens[k]);
                    });
                    // Constant neutral tones (same across themes)
                    const tones = this._constantTones;
                    Object.keys(tones).forEach(function (k) { root.style.setProperty(k, tones[k]); });
                    // Fonts (token-driven; lazy-load the files)
                    this._loadFont(name);
                    root.style.setProperty('--font-heading', pal.fonts.heading);
                    root.style.setProperty('--font-body', pal.fonts.body);
                    // Keep --font-ui/--font-signature as-is (global UI + signature).
                },

                setTheme: function (name) {
                    const resolved = this._aliases[name] || name;
                    if (!this.palettes[resolved]) return false;
                    appData.settings.theme = resolved;   // store canonical key
                    saveDataToLocal();
                    this.applyToRoot();
                    if (typeof renderThemeCards === 'function') renderThemeCards();
                    return true;
                }
            };

            /* =====================================================
               Expose a single namespace for all future modules.
               ===================================================== */
            window.AppEngine = {
                data:          DataManager,
                search:        SearchEngine,
                stats:         StatsEngine,
                notifications: NotificationEngine,
                theme:         ThemeEngine,
                COLLECTIONS:   COLLECTIONS,
                helpers: {
                    makeId: makeId,
                    nowISO: nowISO,
                    ensureCollection: ensureCollection,
                    readPath: readPath
                }
            };

            // Publish CSS variables once the DOM is ready. Purely additive:
            // it defines new custom properties and changes nothing visible.
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', function () {
                    try { ThemeEngine.applyToRoot(); } catch (e) {}
                });
            } else {
                try { ThemeEngine.applyToRoot(); } catch (e) {}
            }
        })();

        // Bind AppEngine to a plain script-scope reference so every module
        // can use the bare name `AppEngine` (not just `window.AppEngine`).
        // Fixes a ReferenceError during init on strict-mode browsers.
        var AppEngine = window.AppEngine;

        /* =========================================================
           ==========  PHASE 3B — DAILY JOURNAL MODULE  ==========
           =========================================================
           UI-facing module logic. All persistence goes through the
           shared AppEngine.data CRUD (collection: 'journal'). No new
           storage system, no change to dashboard / header / nav /
           engine. The FULL v1 schema is written on every save even
           though the UI only exposes: title, content, mood,
           gratitude, favorite. Hidden-but-stored fields: tags[],
           weather, location, images[], archived, createdAt, updatedAt.
           ========================================================= */

        // Mood options (value is language-neutral; label via i18n key).
        const JOURNAL_MOODS = [
            { value: 'happy',   icon: '😊', key: 'mood_happy' },
            { value: 'calm',    icon: '😌', key: 'mood_calm' },
            { value: 'neutral', icon: '😐', key: 'mood_neutral' },
            { value: 'sad',     icon: '😔', key: 'mood_sad' },
            { value: 'tired',   icon: '😴', key: 'mood_tired' }
        ];

        let journalSelectedMood = '';   // transient editor state

        function journalT(key) {
            return (translations[currentLang] && translations[currentLang][key] !== undefined)
                ? translations[currentLang][key]
                : key;
        }

        // Local "today" as YYYY-MM-DD (avoids UTC off-by-one from toISOString).
        function todayYMD() {
            const d = new Date();
            const m = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            return d.getFullYear() + '-' + m + '-' + day;
        }

        // Build the full v1 record from the editor, preserving hidden
        // fields when editing an existing entry.
        function buildJournalRecord(existing) {
            const base = existing || {};
            const dateVal = document.getElementById('journalEntryDate').value || todayYMD();
            return {
                title:     document.getElementById('journalTitle').value.trim(),
                content:   document.getElementById('journalContent').value.trim(),
                entryDate: dateVal,               // YYYY-MM-DD, user-selectable
                mood:      journalSelectedMood || '',
                gratitude: document.getElementById('journalGratitude').value.trim(),
                favorite:  document.getElementById('journalFavorite').checked,
                // ---- schema fields stored from v1 but not yet exposed ----
                tags:      Array.isArray(base.tags) ? base.tags : [],
                weather:   base.weather || '',
                location:  base.location || '',
                images:    Array.isArray(base.images) ? base.images : [],
                archived:  base.archived || false
            };
        }

        function renderMoodPicker() {
            const row = document.getElementById('journalMoodRow');
            if (!row) return;
            row.innerHTML = '';
            JOURNAL_MOODS.forEach(function (m) {
                const btn = document.createElement('button');
                btn.type = 'button';
                const isSel = journalSelectedMood === m.value;
                btn.className = 'font-ui px-3 py-2 rounded-full text-xs font-semibold border transition-all flex items-center gap-1.5 ' +
                    (isSel
                        ? 'bg-app-rose text-white border-app-rose shadow-sm'
                        : 'bg-white text-app-text border-app-beige hover:bg-app-blush/20');
                btn.innerHTML = '<span>' + m.icon + '</span> <span>' + journalT(m.key) + '</span>';
                btn.onclick = function () {
                    // toggle off if same mood tapped again
                    journalSelectedMood = (journalSelectedMood === m.value) ? '' : m.value;
                    renderMoodPicker();
                };
                row.appendChild(btn);
            });
        }

        function openJournalEditor(id) {
            const titleEl = document.getElementById('journalModalTitle');
            document.getElementById('journalEditId').value = id || '';

            if (id) {
                const entry = AppEngine.data.get('journal', id);
                if (!entry) return;
                titleEl.innerText = journalT('journal_modal_edit');
                document.getElementById('journalTitle').value = entry.title || '';
                document.getElementById('journalContent').value = entry.content || '';
                // Keep the original entryDate on edit (fallback to today).
                document.getElementById('journalEntryDate').value = entry.entryDate || todayYMD();
                document.getElementById('journalGratitude').value = entry.gratitude || '';
                document.getElementById('journalFavorite').checked = !!entry.favorite;
                journalSelectedMood = entry.mood || '';
            } else {
                titleEl.innerText = journalT('journal_modal_new');
                document.getElementById('journalTitle').value = '';
                document.getElementById('journalContent').value = '';
                document.getElementById('journalEntryDate').value = todayYMD();  // default today
                document.getElementById('journalGratitude').value = '';
                document.getElementById('journalFavorite').checked = false;
                journalSelectedMood = '';
            }

            renderMoodPicker();
            document.getElementById('journalModal').classList.remove('hidden');
        }

        function closeJournalEditor() {
            document.getElementById('journalModal').classList.add('hidden');
            journalSelectedMood = '';
        }

        // Hero shortcut: go to Journal tab, then open a fresh entry with
        // entryDate defaulting to today. switchTab records dashboard in
        // the back-history so the Back button still works as expected.
        function writeTodaysJournal() {
            switchTab('journal');
            openJournalEditor();   // no id -> new entry, entryDate = today
        }

        function saveJournalEntry() {
            const id = document.getElementById('journalEditId').value;
            const title = document.getElementById('journalTitle').value.trim();
            const content = document.getElementById('journalContent').value.trim();

            // Require at least a title or content.
            if (!title && !content) {
                showToast(journalT('journal_need_content'));
                return;
            }

            if (id) {
                const existing = AppEngine.data.get('journal', id);
                AppEngine.data.update('journal', id, buildJournalRecord(existing));
                showToast(journalT('journal_updated'));
            } else {
                AppEngine.data.save('journal', buildJournalRecord(null));
                showToast(journalT('journal_saved'));
            }

            closeJournalEditor();
            renderJournalList();
        }

        // Delete flow — reuses the existing #customModal confirm dialog.
        let journalPendingDeleteId = null;

        function requestDeleteJournal(id) {
            journalPendingDeleteId = id;
            document.getElementById('modalTitle').innerText = journalT('journal_del_title');
            document.getElementById('modalMessage').innerText = journalT('journal_del_desc');
            // Route the shared confirm button to the journal delete handler.
            pendingAction = 'journal_delete';
            document.getElementById('customModal').classList.remove('hidden');
        }

        function escapeHtml(str) {
            return String(str || '')
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }

        function formatJournalDate(value) {
            if (!value) return '';
            let d;
            // Plain YYYY-MM-DD -> parse as LOCAL date (no UTC shift).
            const ymd = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value);
            if (ymd) {
                d = new Date(Number(ymd[1]), Number(ymd[2]) - 1, Number(ymd[3]));
            } else {
                d = new Date(value);
            }
            if (isNaN(d)) return '';
            return d.toLocaleDateString(currentLang === 'ms' ? 'ms-MY' : 'en-GB',
                { day: '2-digit', month: 'short', year: 'numeric' });
        }

        function renderJournalList() {
            const listEl = document.getElementById('journal-list');
            const emptyEl = document.getElementById('journal-empty');
            const noResEl = document.getElementById('journal-noresult');
            const toolbar = document.getElementById('journal-toolbar');
            if (!listEl) return;

            const all = AppEngine.data.get('journal');   // safe copy
            const hasAny = all.length > 0;

            // Toolbar (search) only visible when there is data.
            toolbar.classList.toggle('hidden', !hasAny);

            // Empty state (no data at all).
            if (!hasAny) {
                emptyEl.classList.remove('hidden');
                noResEl.classList.add('hidden');
                listEl.classList.add('hidden');
                return;
            }
            emptyEl.classList.add('hidden');

            // Apply search, then sort by updatedAt desc (default per spec).
            const q = (document.getElementById('journalSearch') || {}).value || '';
            let entries = q ? AppEngine.data.search('journal', q) : all;
            entries = entries.slice().sort(function (a, b) {
                return new Date(b.updatedAt || b.createdAt) - new Date(a.updatedAt || a.createdAt);
            });

            if (entries.length === 0) {
                noResEl.classList.remove('hidden');
                listEl.classList.add('hidden');
                return;
            }
            noResEl.classList.add('hidden');
            listEl.classList.remove('hidden');

            listEl.innerHTML = entries.map(function (e) {
                const moodObj = JOURNAL_MOODS.find(function (m) { return m.value === e.mood; });
                const moodBadge = moodObj
                    ? '<span class="inline-flex items-center gap-1 text-xs font-semibold text-app-text bg-app-cream px-2.5 py-1 rounded-full">' +
                        moodObj.icon + ' ' + escapeHtml(journalT(moodObj.key)) + '</span>'
                    : '';
                const star = e.favorite
                    ? '<i class="fa-solid fa-star text-app-gold"></i>'
                    : '<i class="fa-regular fa-star text-gray-300"></i>';
                const title = escapeHtml(e.title) || '<span class="text-gray-400 italic">' + escapeHtml(journalT('journal_lbl_title')) + '</span>';
                const snippet = escapeHtml((e.content || '').slice(0, 140)) + ((e.content || '').length > 140 ? '…' : '');
                const gratitude = e.gratitude
                    ? '<p class="text-xs text-gray-500 mt-2 flex items-center gap-1.5"><i class="fa-solid fa-heart text-app-coral"></i> ' + escapeHtml(e.gratitude) + '</p>'
                    : '';

                return '' +
                '<div class="card-soft p-5 bg-white/80 flex flex-col" style="cursor:default">' +
                    '<div class="flex items-start justify-between gap-3 mb-1">' +
                        '<h3 class="font-display text-lg text-app-dark leading-snug">' + title + '</h3>' +
                        '<button onclick="toggleJournalFavorite(\'' + e.id + '\')" class="shrink-0 text-lg focus:outline-none" title="Favorite">' + star + '</button>' +
                    '</div>' +
                    '<p class="font-ui text-[10px] font-bold uppercase tracking-wider text-gray-400 mb-2">' + formatJournalDate(e.entryDate || e.createdAt) + '</p>' +
                    (snippet ? '<p class="text-sm text-gray-600 leading-relaxed flex-1">' + snippet + '</p>' : '<div class="flex-1"></div>') +
                    gratitude +
                    '<div class="flex items-center justify-between mt-4 pt-3 border-t border-app-beige/60">' +
                        '<div>' + moodBadge + '</div>' +
                        '<div class="flex items-center gap-2 font-ui">' +
                            '<button onclick="openJournalEditor(\'' + e.id + '\')" class="text-xs font-semibold text-app-rose hover:text-app-rose-dark px-2 py-1 rounded-full transition flex items-center gap-1"><i class="fa-solid fa-pen"></i> ' + escapeHtml(journalT('btn_edit')) + '</button>' +
                            '<button onclick="requestDeleteJournal(\'' + e.id + '\')" class="text-xs font-semibold text-gray-400 hover:text-red-500 px-2 py-1 rounded-full transition flex items-center gap-1"><i class="fa-solid fa-trash-can"></i> ' + escapeHtml(journalT('btn_delete')) + '</button>' +
                        '</div>' +
                    '</div>' +
                '</div>';
            }).join('');
        }

        function toggleJournalFavorite(id) {
            const entry = AppEngine.data.get('journal', id);
            if (!entry) return;
            // patchMeta keeps updatedAt intact so the card does not jump.
            AppEngine.data.patchMeta('journal', id, { favorite: !entry.favorite });
            renderJournalList();
        }

        /* =========================================================
           ==========  PHASE 3C — MOOD TRACKER MODULE  ===========
           =========================================================
           Reuses the shared AppEngine.data CRUD (collection: 'mood')
           and shared helpers (todayYMD, formatJournalDate, escapeHtml,
           showToast, #customModal). No new storage, no duplicate CRUD,
           no change to other modules. Schema per record:
           { mood, note, entryDate(YYYY-MM-DD), createdAt, updatedAt }.
           ========================================================= */

        // Same mood set as the app (value neutral, label via i18n key).
        const MOOD_OPTIONS = [
            { value: 'happy',   icon: '😊', key: 'mood_happy' },
            { value: 'calm',    icon: '😌', key: 'mood_calm' },
            { value: 'neutral', icon: '😐', key: 'mood_neutral' },
            { value: 'sad',     icon: '😔', key: 'mood_sad' },
            { value: 'tired',   icon: '😴', key: 'mood_tired' }
        ];

        // Populate the <select> options with translated labels + emoji,
        // preserving the current selection. Called on open + language change.
        function renderMoodSelectOptions() {
            const sel = document.getElementById('moodSelect');
            if (!sel) return;
            const prev = sel.value;
            sel.innerHTML = MOOD_OPTIONS.map(function (m) {
                return '<option value="' + m.value + '">' + m.icon + ' ' + escapeHtml(journalT(m.key)) + '</option>';
            }).join('');
            if (prev) sel.value = prev;
        }

        function openMoodEditor(id) {
            const titleEl = document.getElementById('moodModalTitle');
            document.getElementById('moodEditId').value = id || '';
            renderMoodSelectOptions();

            if (id) {
                const entry = AppEngine.data.get('mood', id);
                if (!entry) return;
                titleEl.innerText = journalT('mood_modal_edit');
                document.getElementById('moodSelect').value = entry.mood || 'happy';
                document.getElementById('moodNote').value = entry.note || '';
                document.getElementById('moodEntryDate').value = entry.entryDate || todayYMD();
            } else {
                titleEl.innerText = journalT('mood_modal_new');
                document.getElementById('moodSelect').value = 'happy';
                document.getElementById('moodNote').value = '';
                document.getElementById('moodEntryDate').value = todayYMD();
            }

            document.getElementById('moodModal').classList.remove('hidden');
        }

        function closeMoodEditor() {
            document.getElementById('moodModal').classList.add('hidden');
        }

        function buildMoodRecord() {
            return {
                mood:      document.getElementById('moodSelect').value || 'happy',
                note:      document.getElementById('moodNote').value.trim(),
                entryDate: document.getElementById('moodEntryDate').value || todayYMD()
            };
        }

        function saveMoodEntry() {
            const id = document.getElementById('moodEditId').value;
            if (id) {
                // update() bumps updatedAt; entryDate kept if unchanged in form.
                AppEngine.data.update('mood', id, buildMoodRecord());
                showToast(journalT('mood_updated'));
            } else {
                AppEngine.data.save('mood', buildMoodRecord());
                showToast(journalT('mood_saved'));
            }
            closeMoodEditor();
            renderMoodList();
            updateDashboardMoodCard();
        }

        // Delete — reuses the shared #customModal confirm dialog.
        let moodPendingDeleteId = null;

        function requestDeleteMood(id) {
            moodPendingDeleteId = id;
            document.getElementById('modalTitle').innerText = journalT('mood_del_title');
            document.getElementById('modalMessage').innerText = journalT('mood_del_desc');
            pendingAction = 'mood_delete';
            document.getElementById('customModal').classList.remove('hidden');
        }

        function renderMoodList() {
            const listEl = document.getElementById('mood-list');
            const emptyEl = document.getElementById('mood-empty');
            const noResEl = document.getElementById('mood-noresult');
            const toolbar = document.getElementById('mood-toolbar');
            if (!listEl) return;

            const all = AppEngine.data.get('mood');
            const hasAny = all.length > 0;
            toolbar.classList.toggle('hidden', !hasAny);

            if (!hasAny) {
                emptyEl.classList.remove('hidden');
                noResEl.classList.add('hidden');
                listEl.classList.add('hidden');
                return;
            }
            emptyEl.classList.add('hidden');

            const q = (document.getElementById('moodSearch') || {}).value || '';
            let entries;
            if (q) {
                // Primary search (note, date, raw mood value) via the engine.
                const base = AppEngine.data.search('mood', q);

                // Extra: match by the CURRENT mood LABEL in either language,
                // so BM ("Gembira", "Sedih"...) and EN ("Happy", "Sad"...)
                // both resolve to the language-neutral stored value. Labels
                // are NOT stored on the record — resolved live from i18n.
                const needle = q.toLowerCase();
                const matchedValues = MOOD_OPTIONS.filter(function (m) {
                    const en = (translations.en[m.key] || '').toLowerCase();
                    const ms = (translations.ms[m.key] || '').toLowerCase();
                    return (en && en.indexOf(needle) !== -1) ||
                           (ms && ms.indexOf(needle) !== -1);
                }).map(function (m) { return m.value; });

                const labelHits = matchedValues.length
                    ? all.filter(function (r) { return matchedValues.indexOf(r.mood) !== -1; })
                    : [];

                // Merge base + label hits, de-duplicated by id.
                const seen = {};
                entries = [];
                base.concat(labelHits).forEach(function (r) {
                    if (r && !seen[r.id]) { seen[r.id] = true; entries.push(r); }
                });
            } else {
                entries = all;
            }
            // Sort by updatedAt DESC (newest first).
            entries = entries.slice().sort(function (a, b) {
                return new Date(b.updatedAt || b.createdAt) - new Date(a.updatedAt || a.createdAt);
            });

            if (entries.length === 0) {
                noResEl.classList.remove('hidden');
                listEl.classList.add('hidden');
                return;
            }
            noResEl.classList.add('hidden');
            listEl.classList.remove('hidden');

            listEl.innerHTML = entries.map(function (e) {
                const moodObj = MOOD_OPTIONS.find(function (m) { return m.value === e.mood; });
                const moodLabel = moodObj
                    ? moodObj.icon + ' ' + escapeHtml(journalT(moodObj.key))
                    : escapeHtml(e.mood || '');
                const noteSnippet = e.note
                    ? '<p class="text-sm text-gray-600 leading-relaxed flex-1 mt-1">' +
                        escapeHtml(e.note.slice(0, 140)) + (e.note.length > 140 ? '…' : '') + '</p>'
                    : '<div class="flex-1"></div>';

                return '' +
                '<div class="card-soft p-5 bg-white/80 flex flex-col" style="cursor:default">' +
                    '<div class="flex items-start justify-between gap-3 mb-1">' +
                        '<h3 class="font-display text-xl text-app-dark leading-snug">' + moodLabel + '</h3>' +
                    '</div>' +
                    '<p class="font-ui text-[10px] font-bold uppercase tracking-wider text-gray-400 mb-1">' + formatJournalDate(e.entryDate || e.createdAt) + '</p>' +
                    noteSnippet +
                    '<div class="flex items-center justify-end mt-4 pt-3 border-t border-app-beige/60">' +
                        '<div class="flex items-center gap-2 font-ui">' +
                            '<button onclick="openMoodEditor(\'' + e.id + '\')" class="text-xs font-semibold text-[#7C9069] hover:text-[#5f7350] px-2 py-1 rounded-full transition flex items-center gap-1"><i class="fa-solid fa-pen"></i> ' + escapeHtml(journalT('btn_edit')) + '</button>' +
                            '<button onclick="requestDeleteMood(\'' + e.id + '\')" class="text-xs font-semibold text-gray-400 hover:text-red-500 px-2 py-1 rounded-full transition flex items-center gap-1"><i class="fa-solid fa-trash-can"></i> ' + escapeHtml(journalT('btn_delete')) + '</button>' +
                        '</div>' +
                    '</div>' +
                '</div>';
            }).join('');
        }

        // Dashboard "Today's Mood" card — live, based on entryDate = today.
        function updateDashboardMoodCard() {
            const el = document.getElementById('dash-mood');
            if (!el) return;
            // Phase 3F: read RAW data from the single read layer; the
            // Dashboard owns formatting (emoji + BM/EN label). Never
            // compute cross-module data here directly.
            const stat = AppEngine.stats.todayMood(); // { mood } | null
            if (stat && stat.mood) {
                const moodObj = MOOD_OPTIONS.find(function (m) { return m.value === stat.mood; });
                el.innerText = moodObj
                    ? moodObj.icon + ' ' + journalT(moodObj.key)
                    : (stat.mood || journalT('dash_val_empty'));
            } else {
                el.innerText = journalT('dash_val_empty');
            }
        }

        /* =========================================================
           ==========  PHASE 3D — MONEY TRACKER MODULE  ==========
           =========================================================
           Reuses shared AppEngine.data CRUD (collection: 'money' ->
           stored in appData.transactions). No new storage, no
           duplicate CRUD. Record schema:
           { type, category, amount(Number), date(YYYY-MM-DD),
             note, createdAt, updatedAt }.
           Currency is display-only (appData.settings.currency); the
           stored amount is always a plain number.
           ========================================================= */

        // Category sets per type (values are stable keys via i18n).
        const MONEY_CATEGORIES = {
            income:  [
                { value: 'salary',   key: 'cat_salary' },
                { value: 'side',     key: 'cat_side' },
                { value: 'bonus',    key: 'cat_bonus' },
                { value: 'other_in', key: 'cat_other_in' }
            ],
            expense: [
                { value: 'food',      key: 'cat_food' },
                { value: 'bills',     key: 'cat_bills' },
                { value: 'fuel',      key: 'cat_fuel' },
                { value: 'shopping',  key: 'cat_shopping' },
                { value: 'kids',      key: 'cat_kids' },
                { value: 'health',    key: 'cat_health' },
                { value: 'home',      key: 'cat_home' },
                { value: 'transport', key: 'cat_transport' },
                { value: 'other_ex',  key: 'cat_other_ex' }
            ],
            savings: [
                { value: 'emergency',  key: 'cat_emergency' },
                { value: 'asb',        key: 'cat_asb' },
                { value: 'tabunghaji', key: 'cat_tabunghaji' },
                { value: 'sspn',       key: 'cat_sspn' },
                { value: 'epf',        key: 'cat_epf' },
                { value: 'goal',       key: 'cat_goal' },
                { value: 'custom',     key: 'cat_custom' }
            ]
        };

        let moneyEditorType = 'expense';   // transient editor state
        let moneyFilter = 'all';           // list filter state

        function currencySymbol() {
            return (appData.settings && appData.settings.currency) || 'RM';
        }

        // Format a number with the active currency symbol (display only).
        function formatMoney(amount) {
            const n = Number(amount) || 0;
            const sym = currencySymbol();
            const formatted = n.toLocaleString(currentLang === 'ms' ? 'ms-MY' : 'en-GB',
                { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            // Symbols that read naturally with a trailing space vs attached.
            return sym + formatted;
        }

        // Resolve a category's translated label from its stored value.
        function categoryLabel(type, value) {
            const list = MONEY_CATEGORIES[type] || [];
            const found = list.find(function (c) { return c.value === value; });
            return found ? journalT(found.key) : (value || '');
        }

        function setMoneyType(type) {
            moneyEditorType = type;
            ['income', 'expense', 'savings'].forEach(function (t) {
                const btn = document.getElementById('money-type-' + t);
                if (!btn) return;
                if (t === type) {
                    btn.classList.add('bg-app-gold', 'text-white');
                    btn.classList.remove('bg-white', 'text-app-text');
                } else {
                    btn.classList.remove('bg-app-gold', 'text-white');
                    btn.classList.add('bg-white', 'text-app-text');
                }
            });
            renderMoneyCategoryOptions();
        }

        function renderMoneyCategoryOptions(selectedValue) {
            const sel = document.getElementById('moneyCategory');
            if (!sel) return;
            const list = MONEY_CATEGORIES[moneyEditorType] || [];
            sel.innerHTML = list.map(function (c) {
                return '<option value="' + c.value + '">' + escapeHtml(journalT(c.key)) + '</option>';
            }).join('');
            if (selectedValue) sel.value = selectedValue;
        }

        function openMoneyEditor(id) {
            const titleEl = document.getElementById('moneyModalTitle');
            document.getElementById('moneyEditId').value = id || '';
            document.getElementById('moneyCurrencyPrefix').innerText = currencySymbol();

            if (id) {
                const entry = AppEngine.data.get('money', id);
                if (!entry) return;
                titleEl.innerText = journalT('money_modal_edit');
                moneyEditorType = entry.type || 'expense';
                setMoneyType(moneyEditorType);
                renderMoneyCategoryOptions(entry.category);
                document.getElementById('moneyAmount').value = (entry.amount != null ? entry.amount : '');
                document.getElementById('moneyDate').value = entry.date || todayYMD();
                document.getElementById('moneyNote').value = entry.note || '';
            } else {
                titleEl.innerText = journalT('money_modal_new');
                moneyEditorType = 'expense';
                setMoneyType('expense');
                renderMoneyCategoryOptions();
                document.getElementById('moneyAmount').value = '';
                document.getElementById('moneyDate').value = todayYMD();
                document.getElementById('moneyNote').value = '';
            }

            document.getElementById('moneyModal').classList.remove('hidden');
        }

        function closeMoneyEditor() {
            document.getElementById('moneyModal').classList.add('hidden');
        }

        function buildMoneyRecord() {
            return {
                type:     moneyEditorType,
                category: document.getElementById('moneyCategory').value || '',
                amount:   Number(document.getElementById('moneyAmount').value) || 0,
                date:     document.getElementById('moneyDate').value || todayYMD(),
                note:     document.getElementById('moneyNote').value.trim()
            };
        }

        function saveMoneyEntry() {
            const amt = Number(document.getElementById('moneyAmount').value);
            if (!amt || amt <= 0) {
                showToast(journalT('money_need_amount'));
                return;
            }
            const id = document.getElementById('moneyEditId').value;
            if (id) {
                AppEngine.data.update('money', id, buildMoneyRecord());
                showToast(journalT('money_updated'));
            } else {
                AppEngine.data.save('money', buildMoneyRecord());
                showToast(journalT('money_saved'));
            }
            closeMoneyEditor();
            renderMoneyList();
            updateDashboardMoneyCards();
        }

        // Delete — reuses the shared #customModal confirm dialog.
        let moneyPendingDeleteId = null;

        function requestDeleteMoney(id) {
            moneyPendingDeleteId = id;
            document.getElementById('modalTitle').innerText = journalT('money_del_title');
            document.getElementById('modalMessage').innerText = journalT('money_del_desc');
            pendingAction = 'money_delete';
            document.getElementById('customModal').classList.remove('hidden');
        }

        function setMoneyFilter(filter) {
            moneyFilter = filter;
            ['all', 'income', 'expense', 'savings'].forEach(function (f) {
                const btn = document.getElementById('money-filter-' + f);
                if (!btn) return;
                if (f === filter) {
                    btn.classList.add('bg-app-gold', 'text-white');
                    btn.classList.remove('bg-white', 'text-app-text');
                } else {
                    btn.classList.remove('bg-app-gold', 'text-white');
                    btn.classList.add('bg-white', 'text-app-text');
                }
            });
            renderMoneyList();
        }

        function renderMoneyList() {
            const listEl = document.getElementById('money-list');
            const emptyEl = document.getElementById('money-empty');
            const noResEl = document.getElementById('money-noresult');
            const toolbar = document.getElementById('money-toolbar');
            const summary = document.getElementById('money-summary');
            if (!listEl) return;

            const all = AppEngine.data.get('money');
            const hasAny = all.length > 0;
            toolbar.classList.toggle('hidden', !hasAny);
            summary.classList.toggle('hidden', !hasAny);

            // Always refresh the monthly summary strip.
            renderMoneySummary();

            if (!hasAny) {
                emptyEl.classList.remove('hidden');
                noResEl.classList.add('hidden');
                listEl.classList.add('hidden');
                return;
            }
            emptyEl.classList.add('hidden');

            // Search (engine) + category-label search (BM/EN), then filter by type.
            const q = (document.getElementById('moneySearch') || {}).value || '';
            let entries;
            if (q) {
                const base = AppEngine.data.search('money', q);
                const needle = q.toLowerCase();
                // Match by translated category label in either language.
                const labelHits = all.filter(function (r) {
                    const en = (translations.en[catKeyFor(r.type, r.category)] || '').toLowerCase();
                    const ms = (translations.ms[catKeyFor(r.type, r.category)] || '').toLowerCase();
                    return (en && en.indexOf(needle) !== -1) || (ms && ms.indexOf(needle) !== -1);
                });
                const seen = {};
                entries = [];
                base.concat(labelHits).forEach(function (r) {
                    if (r && !seen[r.id]) { seen[r.id] = true; entries.push(r); }
                });
            } else {
                entries = all.slice();
            }

            if (moneyFilter !== 'all') {
                entries = entries.filter(function (r) { return r.type === moneyFilter; });
            }

            // Sort by date desc, then updatedAt desc as tiebreaker.
            entries.sort(function (a, b) {
                const da = new Date(a.date || a.createdAt);
                const db = new Date(b.date || b.createdAt);
                if (db - da !== 0) return db - da;
                return new Date(b.updatedAt || b.createdAt) - new Date(a.updatedAt || a.createdAt);
            });

            if (entries.length === 0) {
                noResEl.classList.remove('hidden');
                listEl.classList.add('hidden');
                return;
            }
            noResEl.classList.add('hidden');
            listEl.classList.remove('hidden');

            const typeMeta = {
                income:  { color: 'text-emerald-600', bg: 'bg-emerald-50', icon: 'fa-arrow-trend-up', sign: '+' },
                expense: { color: 'text-rose-600',    bg: 'bg-rose-50',    icon: 'fa-arrow-trend-down', sign: '-' },
                savings: { color: 'text-blue-600',     bg: 'bg-blue-50',    icon: 'fa-piggy-bank', sign: '' }
            };

            listEl.innerHTML = entries.map(function (e) {
                const meta = typeMeta[e.type] || typeMeta.expense;
                const cat = escapeHtml(categoryLabel(e.type, e.category));
                const note = e.note ? '<span class="text-gray-400"> · ' + escapeHtml(e.note) + '</span>' : '';
                return '' +
                '<div class="card-soft p-4 bg-white/80 flex items-center gap-4" style="cursor:default">' +
                    '<div class="w-10 h-10 rounded-full ' + meta.bg + ' flex items-center justify-center shrink-0 ' + meta.color + '">' +
                        '<i class="fa-solid ' + meta.icon + '"></i>' +
                    '</div>' +
                    '<div class="flex-1 min-w-0">' +
                        '<p class="font-ui text-sm font-bold text-app-dark truncate">' + cat + note + '</p>' +
                        '<p class="font-ui text-[10px] font-bold uppercase tracking-wider text-gray-400">' + formatJournalDate(e.date || e.createdAt) + '</p>' +
                    '</div>' +
                    '<div class="text-right shrink-0">' +
                        '<p class="font-display text-base ' + meta.color + '">' + meta.sign + formatMoney(e.amount) + '</p>' +
                        '<div class="flex items-center gap-1 justify-end mt-0.5 font-ui">' +
                            '<button onclick="openMoneyEditor(\'' + e.id + '\')" class="text-[11px] font-semibold text-gray-400 hover:text-app-gold px-1.5 py-0.5 rounded transition"><i class="fa-solid fa-pen"></i></button>' +
                            '<button onclick="requestDeleteMoney(\'' + e.id + '\')" class="text-[11px] font-semibold text-gray-400 hover:text-red-500 px-1.5 py-0.5 rounded transition"><i class="fa-solid fa-trash-can"></i></button>' +
                        '</div>' +
                    '</div>' +
                '</div>';
            }).join('');
        }

        // Helper: category i18n key for a record (for label search).
        function catKeyFor(type, value) {
            const list = MONEY_CATEGORIES[type] || [];
            const found = list.find(function (c) { return c.value === value; });
            return found ? found.key : '';
        }

        // Monthly summary strip (income / expense / balance for this month).
        function renderMoneySummary() {
            const incEl = document.getElementById('money-sum-income');
            const expEl = document.getElementById('money-sum-expense');
            const balEl = document.getElementById('money-sum-balance');
            if (!incEl) return;
            const totals = monthlyMoneyTotals();
            incEl.innerText = formatMoney(totals.income);
            expEl.innerText = formatMoney(totals.expense);
            balEl.innerText = formatMoney(totals.income - totals.expense);
        }

        // Current-month totals by type. Phase 3F: delegates to the single
        // read layer (StatsEngine) so there is ONE calculation source. Kept
        // as a thin module-internal wrapper used by the Money summary strip
        // (the Dashboard reads AppEngine.stats directly, not this).
        function monthlyMoneyTotals() {
            const f = AppEngine.stats.monthlyFinance();
            return { income: f.income, expense: f.expense, savings: f.savings };
        }

        // Dashboard money cards — live monthly figures with currency symbol.
        function updateDashboardMoneyCards() {
            // Phase 3F: read RAW totals from the single read layer; the
            // Dashboard owns currency formatting (display-only).
            const totals = AppEngine.stats.monthlyFinance();
            const inc = document.getElementById('dash-income');
            const exp = document.getElementById('dash-expense');
            const sav = document.getElementById('dash-savings');
            if (inc) inc.innerText = formatMoney(totals.income);
            if (exp) exp.innerText = formatMoney(totals.expense);
            if (sav) sav.innerText = formatMoney(totals.savings);
        }

        /* =========================================================
           ==========  PHASE 3E — CALENDAR & EVENT REMINDER  =====
           =========================================================
           Reuses shared AppEngine.data CRUD (collection 'calendar'
           -> stored in appData.events). No new storage, no duplicate
           CRUD. Event schema:
           { title, category, date(YYYY-MM-DD), startTime(HH:mm),
             endTime(HH:mm), allDay, location, note, reminderEnabled,
             reminderOffset, customReminderMinutes, completed,
             createdAt, updatedAt } (+ safe reminder metadata).
           ========================================================= */

        // Category definitions (value neutral; label + icon + colour).
        const CAL_CATEGORIES = [
            { value: 'hospital', key: 'catlbl_hospital', icon: 'fa-hospital',            dot: '#E5989B', text: 'text-app-coral',  bg: 'bg-red-50' },
            { value: 'work',     key: 'catlbl_work',     icon: 'fa-briefcase',           dot: '#818CF8', text: 'text-indigo-500', bg: 'bg-indigo-50' },
            { value: 'class',    key: 'catlbl_class',    icon: 'fa-graduation-cap',      dot: '#60A5FA', text: 'text-blue-500',   bg: 'bg-blue-50' },
            { value: 'school',   key: 'catlbl_school',   icon: 'fa-school',              dot: '#F59E0B', text: 'text-amber-500',  bg: 'bg-amber-50' },
            { value: 'family',   key: 'catlbl_family',   icon: 'fa-people-roof',         dot: '#9EAF8E', text: 'text-[#7C9069]',  bg: 'bg-app-sage/20' },
            { value: 'birthday', key: 'catlbl_birthday', icon: 'fa-cake-candles',        dot: '#F472B6', text: 'text-pink-500',   bg: 'bg-pink-50' },
            { value: 'bill',     key: 'catlbl_bill',     icon: 'fa-file-invoice-dollar', dot: '#10B981', text: 'text-emerald-500',bg: 'bg-emerald-50' },
            { value: 'personal', key: 'catlbl_personal', icon: 'fa-list-check',          dot: '#A9A5C9', text: 'text-indigo-400', bg: 'bg-app-lavender/40' },
            { value: 'other',    key: 'catlbl_other',    icon: 'fa-calendar-check',      dot: '#9CA3AF', text: 'text-gray-500',   bg: 'bg-gray-100' }
        ];

        function calCat(value) {
            return CAL_CATEGORIES.find(function (c) { return c.value === value; }) || CAL_CATEGORIES[CAL_CATEGORIES.length - 1];
        }
        function calCatKeyFor(value) {
            const c = CAL_CATEGORIES.find(function (x) { return x.value === value; });
            return c ? c.key : '';
        }

        // Transient calendar state (not persisted).
        let calendarViewDate = new Date();
        let calendarSelectedDate = todayYMD();
        let calendarCategoryFilter = 'all';
        let calendarPendingDeleteId = null;

        // Parse YYYY-MM-DD as a LOCAL date (avoid UTC shift).
        function parseLocalYMD(ymd) {
            if (!ymd) return null;
            const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(ymd);
            if (!m) { const d = new Date(ymd); return isNaN(d) ? null : d; }
            return new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
        }

        // All events for a given YYYY-MM-DD (safe copy).
        function getEventsForDate(dateYMD) {
            return AppEngine.data.get('calendar').filter(function (e) { return e.date === dateYMD; });
        }

        // Sort events within a day: all-day first, then earliest start,
        // then most-recently-updated.
        function sortDayEvents(list) {
            return list.slice().sort(function (a, b) {
                if (a.allDay && !b.allDay) return -1;
                if (!a.allDay && b.allDay) return 1;
                const at = a.startTime || '99:99';
                const bt = b.startTime || '99:99';
                if (at !== bt) return at < bt ? -1 : 1;
                return new Date(b.updatedAt || b.createdAt) - new Date(a.updatedAt || a.createdAt);
            });
        }

        /* ---------- Editor modal ---------- */

        function renderCalCategoryOptions(selected) {
            const sel = document.getElementById('calCategory');
            if (!sel) return;
            sel.innerHTML = CAL_CATEGORIES.map(function (c) {
                return '<option value="' + c.value + '">' + escapeHtml(journalT(c.key)) + '</option>';
            }).join('');
            if (selected) sel.value = selected;
        }

        function toggleCalAllDay() {
            const on = document.getElementById('calAllDay').checked;
            document.getElementById('cal-time-row').style.display = on ? 'none' : '';
        }
        function toggleCalReminder() {
            const on = document.getElementById('calReminderEnabled').checked;
            document.getElementById('cal-reminder-row').classList.toggle('hidden', !on);
            if (on) toggleCalCustomReminder();
        }
        function toggleCalCustomReminder() {
            const isCustom = document.getElementById('calReminderOffset').value === 'custom';
            document.getElementById('cal-custom-reminder-row').classList.toggle('hidden', !isCustom);
        }

        function openCalendarEditor(id, presetDate) {
            const titleEl = document.getElementById('calendarModalTitle');
            document.getElementById('calendarEditId').value = id || '';
            renderCalCategoryOptions();

            if (id) {
                const e = AppEngine.data.get('calendar', id);
                if (!e) return;
                titleEl.innerText = journalT('cal_modal_edit');
                document.getElementById('calTitle').value = e.title || '';
                renderCalCategoryOptions(e.category || 'other');
                document.getElementById('calDate').value = e.date || todayYMD();
                document.getElementById('calAllDay').checked = !!e.allDay;
                document.getElementById('calStart').value = e.startTime || '';
                document.getElementById('calEnd').value = e.endTime || '';
                document.getElementById('calLocation').value = e.location || '';
                document.getElementById('calNote').value = e.note || '';
                document.getElementById('calReminderEnabled').checked = !!e.reminderEnabled;
                document.getElementById('calReminderOffset').value = e.reminderOffset || 'at_time';
                document.getElementById('calCustomMinutes').value = (e.customReminderMinutes != null ? e.customReminderMinutes : '');
            } else {
                titleEl.innerText = journalT('cal_modal_new');
                document.getElementById('calTitle').value = '';
                renderCalCategoryOptions('other');
                document.getElementById('calDate').value = presetDate || todayYMD();
                document.getElementById('calAllDay').checked = false;
                document.getElementById('calStart').value = '';
                document.getElementById('calEnd').value = '';
                document.getElementById('calLocation').value = '';
                document.getElementById('calNote').value = '';
                document.getElementById('calReminderEnabled').checked = false;
                document.getElementById('calReminderOffset').value = 'at_time';
                document.getElementById('calCustomMinutes').value = '';
            }
            toggleCalAllDay();
            toggleCalReminder();
            document.getElementById('calendarModal').classList.remove('hidden');
        }

        function openCalendarEditorForSelected() {
            openCalendarEditor(null, calendarSelectedDate);
        }

        function closeCalendarEditor() {
            document.getElementById('calendarModal').classList.add('hidden');
        }

        function buildCalendarRecord(existing) {
            const base = existing || {};
            const allDay = document.getElementById('calAllDay').checked;
            const remOn = document.getElementById('calReminderEnabled').checked;
            const offset = document.getElementById('calReminderOffset').value || 'at_time';
            const customMin = Number(document.getElementById('calCustomMinutes').value) || 0;
            return {
                title:     document.getElementById('calTitle').value.trim(),
                category:  document.getElementById('calCategory').value || 'other',
                date:      document.getElementById('calDate').value || todayYMD(),
                startTime: allDay ? '' : (document.getElementById('calStart').value || ''),
                endTime:   allDay ? '' : (document.getElementById('calEnd').value || ''),
                allDay:    allDay,
                location:  document.getElementById('calLocation').value.trim(),
                note:      document.getElementById('calNote').value.trim(),
                reminderEnabled: remOn,
                reminderOffset:  remOn ? offset : '',
                customReminderMinutes: (remOn && offset === 'custom') ? customMin : 0,
                completed: base.completed || false,
                // Preserve reminder-fired metadata across edits.
                reminderTriggeredFor: base.reminderTriggeredFor || ''
            };
        }

        function saveCalendarEvent() {
            const title = document.getElementById('calTitle').value.trim();
            const date = document.getElementById('calDate').value;
            const category = document.getElementById('calCategory').value;
            const allDay = document.getElementById('calAllDay').checked;
            const start = document.getElementById('calStart').value;
            const end = document.getElementById('calEnd').value;
            const remOn = document.getElementById('calReminderEnabled').checked;
            const offset = document.getElementById('calReminderOffset').value;
            const customMin = Number(document.getElementById('calCustomMinutes').value);

            if (!title) { showToast(journalT('cal_err_title')); return; }
            if (!date) { showToast(journalT('cal_err_date')); return; }
            if (!category) { showToast(journalT('cal_err_category')); return; }
            if (!allDay && !start) { showToast(journalT('cal_err_start')); return; }
            if (!allDay && start && end && end < start) { showToast(journalT('cal_err_endbefore')); return; }
            if (remOn && offset === 'custom' && (!customMin || customMin < 1)) { showToast(journalT('cal_err_custom')); return; }

            const id = document.getElementById('calendarEditId').value;
            let savedDate = date;
            if (id) {
                const existing = AppEngine.data.get('calendar', id);
                AppEngine.data.update('calendar', id, buildCalendarRecord(existing));
                showToast(journalT('cal_updated'));
            } else {
                AppEngine.data.save('calendar', buildCalendarRecord(null));
                showToast(journalT('cal_saved'));
            }
            closeCalendarEditor();
            calendarSelectedDate = savedDate;
            calendarViewDate = parseLocalYMD(savedDate) || new Date();
            renderCalendarModule();
            updateDashboardReminderCard();
        }

        /* ---------- Delete (shared confirm modal) ---------- */

        function requestDeleteCalendar(id) {
            calendarPendingDeleteId = id;
            document.getElementById('modalTitle').innerText = journalT('cal_del_title');
            document.getElementById('modalMessage').innerText = journalT('cal_del_desc');
            pendingAction = 'calendar_delete';
            document.getElementById('customModal').classList.remove('hidden');
        }

        /* ---------- Completed toggle (patchMeta = no updatedAt bump) ---------- */

        function toggleCalendarComplete(id) {
            const e = AppEngine.data.get('calendar', id);
            if (!e) return;
            AppEngine.data.patchMeta('calendar', id, { completed: !e.completed });
            renderCalendarEventList();
            updateDashboardReminderCard();
        }

        /* ---------- Month grid rendering ---------- */

        function renderCalendarWeekdays() {
            const row = document.getElementById('cal-weekdays');
            if (!row) return;
            // Build Sun..Sat labels from a known week using locale.
            const base = new Date(2026, 0, 4); // 2026-01-04 is a Sunday
            let html = '';
            for (let i = 0; i < 7; i++) {
                const d = new Date(base.getFullYear(), base.getMonth(), base.getDate() + i);
                const label = d.toLocaleDateString(currentLang === 'ms' ? 'ms-MY' : 'en-GB', { weekday: 'short' });
                html += '<div>' + escapeHtml(label) + '</div>';
            }
            row.innerHTML = html;
        }

        function renderCalendarGrid() {
            const grid = document.getElementById('cal-grid');
            const label = document.getElementById('cal-month-label');
            if (!grid) return;

            const y = calendarViewDate.getFullYear();
            const m = calendarViewDate.getMonth();
            label.innerText = calendarViewDate.toLocaleDateString(currentLang === 'ms' ? 'ms-MY' : 'en-GB', { month: 'long', year: 'numeric' });

            const firstDay = new Date(y, m, 1);
            const startWeekday = firstDay.getDay(); // 0=Sun
            const daysInMonth = new Date(y, m + 1, 0).getDate();
            const today = todayYMD();

            let cells = [];
            // Leading days from previous month (faded).
            const prevDays = new Date(y, m, 0).getDate();
            for (let i = startWeekday - 1; i >= 0; i--) {
                cells.push({ day: prevDays - i, muted: true, ymd: null });
            }
            // Current month.
            for (let d = 1; d <= daysInMonth; d++) {
                const ymd = y + '-' + String(m + 1).padStart(2, '0') + '-' + String(d).padStart(2, '0');
                cells.push({ day: d, muted: false, ymd: ymd });
            }
            // Trailing to fill full weeks.
            while (cells.length % 7 !== 0) {
                const nextDay = cells.length - (startWeekday + daysInMonth) + 1;
                cells.push({ day: nextDay, muted: true, ymd: null });
            }

            grid.innerHTML = cells.map(function (c) {
                if (c.muted) {
                    return '<div class="aspect-square sm:aspect-auto sm:min-h-[64px] rounded-xl flex items-start justify-center pt-1.5 text-gray-300 text-xs sm:text-sm select-none">' + c.day + '</div>';
                }
                const isToday = c.ymd === today;
                const isSelected = c.ymd === calendarSelectedDate;
                const dayEvents = getEventsForDate(c.ymd);
                // Unique categories (max 3 dots + "+").
                const cats = [];
                dayEvents.forEach(function (e) { if (cats.indexOf(e.category) === -1) cats.push(e.category); });
                let dotsHtml = '';
                cats.slice(0, 3).forEach(function (cat) {
                    const anyDone = dayEvents.filter(function (e){return e.category===cat;}).every(function (e){return e.completed;});
                    dotsHtml += '<span class="inline-block w-1.5 h-1.5 rounded-full" style="background:' + calCat(cat).dot + ';opacity:' + (anyDone ? '0.4' : '1') + '"></span>';
                });
                if (cats.length > 3) dotsHtml += '<span class="text-[8px] font-bold text-gray-400 leading-none">+</span>';

                let cls = 'aspect-square sm:aspect-auto sm:min-h-[64px] rounded-xl flex flex-col items-center pt-1.5 cursor-pointer transition border ';
                if (isSelected) cls += 'bg-app-primary text-white border-app-primary shadow-sm ';
                else if (isToday) cls += 'bg-app-primary-soft text-app-primary-dark border-app-primary/30 ';
                else cls += 'bg-white text-app-dark border-transparent hover:bg-app-cream ';

                return '<div role="button" tabindex="0" aria-label="' + escapeHtml(formatJournalDate(c.ymd)) + '" ' +
                    'onclick="selectCalendarDate(\'' + c.ymd + '\')" ' +
                    'onkeydown="if(event.key===\'Enter\'||event.key===\' \'){event.preventDefault();selectCalendarDate(\'' + c.ymd + '\');}" ' +
                    'class="' + cls + '">' +
                        '<span class="text-xs sm:text-sm font-semibold leading-none mb-1">' + c.day + '</span>' +
                        '<span class="flex items-center gap-0.5 h-2">' + dotsHtml + '</span>' +
                    '</div>';
            }).join('');
        }

        function selectCalendarDate(ymd) {
            calendarSelectedDate = ymd;
            renderCalendarGrid();
            renderCalendarSelectedTitle();
            renderCalendarEventList();
        }

        function renderCalendarSelectedTitle() {
            const el = document.getElementById('cal-selected-title');
            if (!el) return;
            el.innerText = journalT('cal_events_on') + ' ' + formatJournalDate(calendarSelectedDate);
        }

        function calendarPrevMonth() {
            calendarViewDate = new Date(calendarViewDate.getFullYear(), calendarViewDate.getMonth() - 1, 1);
            renderCalendarGrid();
        }
        function calendarNextMonth() {
            calendarViewDate = new Date(calendarViewDate.getFullYear(), calendarViewDate.getMonth() + 1, 1);
            renderCalendarGrid();
        }
        function calendarGoToday() {
            calendarViewDate = new Date();
            calendarSelectedDate = todayYMD();
            renderCalendarModule();
        }

        function setCalendarFilter(value) {
            calendarCategoryFilter = value;
            renderCalendarEventList();
        }

        function renderCalendarFilterOptions() {
            const sel = document.getElementById('calendarFilter');
            if (!sel) return;
            const prev = calendarCategoryFilter;
            let html = '<option value="all">' + escapeHtml(journalT('cal_filter_all')) + '</option>';
            CAL_CATEGORIES.forEach(function (c) {
                html += '<option value="' + c.value + '">' + escapeHtml(journalT(c.key)) + '</option>';
            });
            sel.innerHTML = html;
            sel.value = prev;
        }

        function formatEventTime(e) {
            if (e.allDay) return journalT('cal_allday_badge');
            if (!e.startTime) return '';
            const s = formatClock(e.startTime);
            if (e.endTime) return s + ' – ' + formatClock(e.endTime);
            return s;
        }
        // HH:mm -> localized clock (e.g. 10:00 AM / 10:00 pagi handled by locale).
        function formatClock(hhmm) {
            const m = /^(\d{2}):(\d{2})$/.exec(hhmm);
            if (!m) return hhmm;
            const d = new Date(2026, 0, 1, Number(m[1]), Number(m[2]));
            return d.toLocaleTimeString(currentLang === 'ms' ? 'ms-MY' : 'en-GB', { hour: '2-digit', minute: '2-digit' });
        }

        function renderCalendarEventList() {
            const listEl = document.getElementById('cal-event-list');
            const emptyEl = document.getElementById('cal-event-empty');
            const noResEl = document.getElementById('cal-event-noresult');
            const toolbar = document.getElementById('cal-toolbar');
            if (!listEl) return;

            let dayEvents = getEventsForDate(calendarSelectedDate);

            // Toolbar visible if this date has any events.
            toolbar.classList.toggle('hidden', dayEvents.length === 0);

            // Search (engine + BM/EN category label), dedup by id.
            const q = (document.getElementById('calendarSearch') || {}).value || '';
            if (q) {
                const base = AppEngine.data.search('calendar', q).filter(function (e) { return e.date === calendarSelectedDate; });
                const needle = q.toLowerCase();
                const labelHits = dayEvents.filter(function (e) {
                    const key = calCatKeyFor(e.category);
                    const en = (translations.en[key] || '').toLowerCase();
                    const ms = (translations.ms[key] || '').toLowerCase();
                    return (en && en.indexOf(needle) !== -1) || (ms && ms.indexOf(needle) !== -1);
                });
                const seen = {}; const merged = [];
                base.concat(labelHits).forEach(function (e) { if (e && !seen[e.id]) { seen[e.id] = true; merged.push(e); } });
                dayEvents = merged;
            }

            // Category filter (list only).
            if (calendarCategoryFilter !== 'all') {
                dayEvents = dayEvents.filter(function (e) { return e.category === calendarCategoryFilter; });
            }

            dayEvents = sortDayEvents(dayEvents);

            // Empty vs no-result.
            const anyForDate = getEventsForDate(calendarSelectedDate).length > 0;
            if (dayEvents.length === 0) {
                listEl.innerHTML = '';
                listEl.classList.add('hidden');
                if (anyForDate) { noResEl.classList.remove('hidden'); emptyEl.classList.add('hidden'); }
                else { emptyEl.classList.remove('hidden'); noResEl.classList.add('hidden'); }
                return;
            }
            emptyEl.classList.add('hidden');
            noResEl.classList.add('hidden');
            listEl.classList.remove('hidden');

            listEl.innerHTML = dayEvents.map(function (e) {
                const cat = calCat(e.category);
                const time = formatEventTime(e);
                const loc = e.location ? '<p class="text-xs text-gray-500 mt-1 flex items-center gap-1.5"><i class="fa-solid fa-location-dot text-gray-300"></i> ' + escapeHtml(e.location) + '</p>' : '';
                const note = e.note ? '<p class="text-xs text-gray-400 mt-1">' + escapeHtml(e.note) + '</p>' : '';
                const rem = e.reminderEnabled ? '<span class="text-[10px] font-semibold text-indigo-400 flex items-center gap-1"><i class="fa-regular fa-bell"></i> ' + escapeHtml(journalT('cal_reminder_label')) + ': ' + escapeHtml(reminderOffsetLabel(e)) + '</span>' : '';
                const titleCls = e.completed ? 'line-through decoration-1 text-gray-400' : 'text-app-dark';
                const completeLabel = e.completed ? journalT('cal_reopen') : journalT('cal_mark_complete');
                const completeIcon = e.completed ? 'fa-rotate-left' : 'fa-check';

                return '' +
                '<div class="card-soft p-4 bg-white/80 flex gap-4" style="cursor:default">' +
                    '<div class="w-10 h-10 rounded-full ' + cat.bg + ' ' + cat.text + ' flex items-center justify-center shrink-0"><i class="fa-solid ' + cat.icon + '"></i></div>' +
                    '<div class="flex-1 min-w-0">' +
                        '<div class="flex items-start justify-between gap-2">' +
                            '<h4 class="font-display text-lg leading-snug ' + titleCls + '">' + escapeHtml(e.title) + '</h4>' +
                        '</div>' +
                        '<p class="text-[10px] font-bold uppercase tracking-wider ' + cat.text + ' mb-0.5">' + escapeHtml(journalT(cat.key)) + '</p>' +
                        (time ? '<p class="text-xs font-semibold text-gray-600">' + escapeHtml(time) + '</p>' : '') +
                        loc + note +
                        '<div class="flex items-center gap-3 mt-2">' + rem + '</div>' +
                        '<div class="flex items-center gap-2 mt-3 pt-2 border-t border-app-beige/60 font-ui">' +
                            '<button type="button" onclick="toggleCalendarComplete(\'' + e.id + '\')" class="text-[11px] font-semibold ' + (e.completed ? 'text-gray-400' : 'text-emerald-600') + ' hover:opacity-80 px-2 py-1 rounded transition flex items-center gap-1"><i class="fa-solid ' + completeIcon + '"></i> ' + escapeHtml(completeLabel) + '</button>' +
                            '<button type="button" onclick="openCalendarEditor(\'' + e.id + '\')" class="text-[11px] font-semibold text-app-primary hover:text-app-primary-dark px-2 py-1 rounded transition flex items-center gap-1"><i class="fa-solid fa-pen"></i> ' + escapeHtml(journalT('btn_edit')) + '</button>' +
                            '<button type="button" onclick="requestDeleteCalendar(\'' + e.id + '\')" class="text-[11px] font-semibold text-gray-400 hover:text-red-500 px-2 py-1 rounded transition flex items-center gap-1"><i class="fa-solid fa-trash-can"></i> ' + escapeHtml(journalT('btn_delete')) + '</button>' +
                        '</div>' +
                    '</div>' +
                '</div>';
            }).join('');
        }

        function reminderOffsetLabel(e) {
            const map = { at_time:'cal_rem_at', '15_minutes':'cal_rem_15', '30_minutes':'cal_rem_30', '1_hour':'cal_rem_1h', '1_day':'cal_rem_1d', custom:'cal_rem_custom' };
            if (e.reminderOffset === 'custom') {
                return (e.customReminderMinutes || 0) + ' ' + journalT('cal_lbl_custom_min').toLowerCase();
            }
            return journalT(map[e.reminderOffset] || 'cal_rem_at');
        }

        function renderCalendarModule() {
            renderCalendarWeekdays();
            renderCalendarGrid();
            renderCalendarSelectedTitle();
            renderCalendarFilterOptions();
            renderCalendarEventList();
        }

        /* ---------- Upcoming events (shared) ---------- */

        // Reusable accessor for upcoming events. Phase 3F: delegates to the
        // single read layer (StatsEngine) so there is ONE calculation source.
        // Future modules (Reminder view, Timeline) should read via
        // AppEngine.stats directly; this wrapper is kept for continuity.
        function getUpcomingCalendarEvents() {
            return AppEngine.stats.upcomingEvents();
        }

        // Local Date for an event's start (all-day -> start of that day).
        function eventDateTime(e) {
            const d = parseLocalYMD(e.date);
            if (!d) return null;
            if (e.allDay || !e.startTime) return d;
            const m = /^(\d{2}):(\d{2})$/.exec(e.startTime);
            if (m) { d.setHours(Number(m[1]), Number(m[2]), 0, 0); }
            return d;
        }

        function updateDashboardReminderCard() {
            const el = document.getElementById('dash-reminder');
            if (!el) return;
            // Phase 3F: read RAW upcoming event from the single read layer;
            // the Dashboard owns relative-day + time formatting (BM/EN).
            const e = AppEngine.stats.nextUpcomingEvent();
            if (!e) {
                el.innerText = journalT('cal_no_upcoming');
                return;
            }
            el.innerText = e.title + ' · ' + relativeDayLabel(e) + (e.allDay ? ' · ' + journalT('cal_allday_badge') : (e.startTime ? ' · ' + formatClock(e.startTime) : ''));
        }

        function relativeDayLabel(e) {
            const today = todayYMD();
            const tomorrow = (function () {
                const d = new Date(); d.setDate(d.getDate() + 1);
                return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
            })();
            if (e.date === today) return journalT('cal_today_word');
            if (e.date === tomorrow) return journalT('cal_tomorrow_word');
            return formatJournalDate(e.date);
        }

        // Dashboard reminder card tap -> open Calendar on nearest event.
        function openReminderFromDashboard() {
            // Phase 3F: read nearest event from the single read layer.
            const e = AppEngine.stats.nextUpcomingEvent();
            if (e) {
                calendarSelectedDate = e.date;
                calendarViewDate = parseLocalYMD(e.date) || new Date();
            }
            switchTab('calendar');
        }

        /* ---------- In-app reminder scan (on init) ---------- */

        function runInAppReminderScan() {
            try {
                const now = new Date();
                const events = AppEngine.data.get('calendar');
                events.forEach(function (e) {
                    if (!e.reminderEnabled || e.completed) return;
                    const evtDt = eventDateTime(e);
                    if (!evtDt) return;
                    // Reminder time = event time - offset.
                    let offsetMin = 0;
                    switch (e.reminderOffset) {
                        case '15_minutes': offsetMin = 15; break;
                        case '30_minutes': offsetMin = 30; break;
                        case '1_hour': offsetMin = 60; break;
                        case '1_day': offsetMin = 1440; break;
                        case 'custom': offsetMin = Number(e.customReminderMinutes) || 0; break;
                        default: offsetMin = 0;
                    }
                    const remindAt = new Date(evtDt.getTime() - offsetMin * 60000);
                    // Fire only if reminder time reached, event not passed, and not already fired for this event date.
                    if (now.getTime() >= remindAt.getTime() && now.getTime() <= evtDt.getTime() + 60000) {
                        const marker = e.date + '|' + (e.startTime || 'allday');
                        if (e.reminderTriggeredFor !== marker) {
                            // Persist marker WITHOUT bumping updatedAt.
                            AppEngine.data.patchMeta('calendar', e.id, { reminderTriggeredFor: marker });
                            if (window.AppEngine && AppEngine.notifications) {
                                AppEngine.notifications.notify('calendar', journalT('cal_reminder_toast') + ': ' + e.title, { eventId: e.id });
                            }
                            showToast(journalT('cal_reminder_toast') + ': ' + e.title);
                        }
                    }
                });
            } catch (err) { /* never break init */ }
        }

        /* =========================================================
           ==========  PHASE 3G — TIMELINE VIEW (read-only)  =====
           =========================================================
           Presentation layer for the unified timeline. Reads NORMALIZED
           RAW items from AppEngine.stats.timeline() and formats them
           (emoji, BM/EN labels, currency). Read-only: tapping an item
           routes to its source module's editor (switchTab -> open*Editor).
           No storage, no CRUD, no schema, no duplicate data.
           ========================================================= */

        let timelineFilter = 'all';       // full-view filter
        let timelineOffset = 0;           // full-view paging cursor
        const TIMELINE_PAGE = 10;         // items per Load More
        const DASH_TIMELINE_LIMIT = 5;    // items shown on the dashboard

        // Meta per source: icon + accent colour (presentation only).
        const TL_SOURCE_META = {
            journal:  { icon: 'fa-pen-nib',       text: 'text-app-rose',   bg: 'bg-app-blush/40' },
            mood:     { icon: 'fa-face-smile',     text: 'text-[#7C9069]',  bg: 'bg-app-sage/20' },
            money:    { icon: 'fa-wallet',         text: 'text-app-gold',   bg: 'bg-app-gold/10' },
            calendar: { icon: 'fa-calendar-check', text: 'text-blue-500',   bg: 'bg-blue-50' }
        };

        // Format one normalized item into { icon, iconText, iconBg, title,
        // subtitle, dateLabel } — all display strings (BM/EN aware).
        function formatTimelineItem(it) {
            const meta = TL_SOURCE_META[it.source] || TL_SOURCE_META.journal;
            let title = '', subtitle = '';

            if (it.source === 'journal') {
                title = it.data.title || journalT('tl_untitled');
                const moodObj = it.data.mood ? MOOD_OPTIONS.find(function (m) { return m.value === it.data.mood; }) : null;
                subtitle = journalT('tl_src_journal') + (moodObj ? ' · ' + moodObj.icon : '') + (it.data.favorite ? ' · ⭐' : '');
            } else if (it.source === 'mood') {
                const moodObj = MOOD_OPTIONS.find(function (m) { return m.value === it.data.mood; });
                title = moodObj ? (moodObj.icon + ' ' + journalT(moodObj.key)) : journalT('tl_src_mood');
                subtitle = journalT('tl_src_mood') + (it.data.note ? ' · ' + it.data.note : '');
            } else if (it.source === 'money') {
                const typeKey = it.data.type === 'income' ? 'tl_money_income' : (it.data.type === 'savings' ? 'tl_money_savings' : 'tl_money_expense');
                const catLabel = categoryLabel(it.data.type, it.data.category);
                title = journalT(typeKey) + ' · ' + catLabel;
                subtitle = formatMoney(it.data.amount);
            } else if (it.source === 'calendar') {
                title = it.data.title || journalT('tl_untitled');
                const catObj = (typeof calCat === 'function') ? calCat(it.data.category) : null;
                const catLabel = catObj ? journalT(catObj.key) : '';
                const timeStr = it.data.allDay ? journalT('cal_allday_badge') : (it.data.startTime ? formatClock(it.data.startTime) : '');
                subtitle = journalT('tl_src_calendar') + (catLabel ? ' · ' + catLabel : '') + (timeStr ? ' · ' + timeStr : '');
            }

            return {
                icon: meta.icon, iconText: meta.text, iconBg: meta.bg,
                title: title, subtitle: subtitle,
                dateLabel: formatJournalDate(it.date)
            };
        }

        // Render a list of normalized items into a container element.
        function renderTimelineItems(containerId, items) {
            const el = document.getElementById(containerId);
            if (!el) return;
            el.innerHTML = items.map(function (it) {
                const f = formatTimelineItem(it);
                return '' +
                '<div role="button" tabindex="0" ' +
                    'onclick="openTimelineItem(\'' + it.source + '\',\'' + it.sourceId + '\')" ' +
                    'onkeydown="if(event.key===\'Enter\'||event.key===\' \'){event.preventDefault();openTimelineItem(\'' + it.source + '\',\'' + it.sourceId + '\');}" ' +
                    'class="card-soft p-3.5 bg-white/80 flex items-center gap-3.5">' +
                    '<div class="w-9 h-9 rounded-full ' + f.iconBg + ' ' + f.iconText + ' flex items-center justify-center shrink-0"><i class="fa-solid ' + f.icon + '"></i></div>' +
                    '<div class="flex-1 min-w-0">' +
                        '<p class="font-ui text-sm font-bold text-app-dark truncate">' + escapeHtml(f.title) + '</p>' +
                        (f.subtitle ? '<p class="font-ui text-xs text-gray-500 truncate">' + escapeHtml(f.subtitle) + '</p>' : '') +
                    '</div>' +
                    '<span class="font-ui text-[10px] font-bold uppercase tracking-wider text-gray-400 shrink-0">' + escapeHtml(f.dateLabel) + '</span>' +
                '</div>';
            }).join('');
        }

        // Tap -> route to source module's editor (never edit in Timeline).
        function openTimelineItem(source, id) {
            closeTimelineFull();
            switchTab(source);
            // Open the source module's existing editor after the tab is active.
            if (source === 'journal') { openJournalEditor(id); }
            else if (source === 'mood') { openMoodEditor(id); }
            else if (source === 'money') { openMoneyEditor(id); }
            else if (source === 'calendar') { openCalendarEditor(id); }
        }

        // Dashboard "Recent Journey" — 5 most recent items.
        function renderDashboardTimeline() {
            const listEl = document.getElementById('dash-timeline');
            const emptyEl = document.getElementById('dash-timeline-empty');
            if (!listEl) return;
            const res = AppEngine.stats.timeline({ limit: DASH_TIMELINE_LIMIT, offset: 0 });
            if (res.total === 0) {
                listEl.innerHTML = '';
                listEl.classList.add('hidden');
                emptyEl.classList.remove('hidden');
                return;
            }
            emptyEl.classList.add('hidden');
            listEl.classList.remove('hidden');
            renderTimelineItems('dash-timeline', res.items);
        }

        /* ---------- Full Timeline overlay ---------- */

        function openTimelineFull() {
            timelineFilter = 'all';
            timelineOffset = 0;
            setTimelineFilterButtons('all');
            document.getElementById('tl-full-list').innerHTML = '';
            renderTimelineFull(true);
            document.getElementById('timelineModal').classList.remove('hidden');
        }

        function closeTimelineFull() {
            document.getElementById('timelineModal').classList.add('hidden');
        }

        function setTimelineFilterButtons(active) {
            ['all', 'journal', 'mood', 'money', 'calendar'].forEach(function (f) {
                const btn = document.getElementById('tl-filter-' + f);
                if (!btn) return;
                if (f === active) {
                    btn.classList.add('bg-app-rose', 'text-white');
                    btn.classList.remove('bg-white', 'text-app-text');
                } else {
                    btn.classList.remove('bg-app-rose', 'text-white');
                    btn.classList.add('bg-white', 'text-app-text');
                }
            });
        }

        function setTimelineFilter(filter) {
            timelineFilter = filter;
            timelineOffset = 0;
            setTimelineFilterButtons(filter);
            document.getElementById('tl-full-list').innerHTML = '';
            renderTimelineFull(true);
        }

        // reset=true clears the list; otherwise appends (Load More).
        function renderTimelineFull(reset) {
            const sources = (timelineFilter === 'all') ? undefined : [timelineFilter];
            const res = AppEngine.stats.timeline({ limit: TIMELINE_PAGE, offset: timelineOffset, sources: sources });
            const listEl = document.getElementById('tl-full-list');
            const emptyEl = document.getElementById('tl-full-empty');
            const moreBtn = document.getElementById('tl-load-more');

            if (res.total === 0) {
                listEl.innerHTML = '';
                emptyEl.classList.remove('hidden');
                moreBtn.classList.add('hidden');
                return;
            }
            emptyEl.classList.add('hidden');

            // Append this page's items to whatever is already rendered.
            const html = res.items.map(function (it) {
                const f = formatTimelineItem(it);
                return '' +
                '<div role="button" tabindex="0" ' +
                    'onclick="openTimelineItem(\'' + it.source + '\',\'' + it.sourceId + '\')" ' +
                    'onkeydown="if(event.key===\'Enter\'||event.key===\' \'){event.preventDefault();openTimelineItem(\'' + it.source + '\',\'' + it.sourceId + '\');}" ' +
                    'class="card-soft p-3.5 bg-white/80 flex items-center gap-3.5">' +
                    '<div class="w-9 h-9 rounded-full ' + f.iconBg + ' ' + f.iconText + ' flex items-center justify-center shrink-0"><i class="fa-solid ' + f.icon + '"></i></div>' +
                    '<div class="flex-1 min-w-0">' +
                        '<p class="font-ui text-sm font-bold text-app-dark truncate">' + escapeHtml(f.title) + '</p>' +
                        (f.subtitle ? '<p class="font-ui text-xs text-gray-500 truncate">' + escapeHtml(f.subtitle) + '</p>' : '') +
                    '</div>' +
                    '<span class="font-ui text-[10px] font-bold uppercase tracking-wider text-gray-400 shrink-0">' + escapeHtml(f.dateLabel) + '</span>' +
                '</div>';
            }).join('');
            if (reset) listEl.innerHTML = html;
            else listEl.insertAdjacentHTML('beforeend', html);

            moreBtn.classList.toggle('hidden', !res.hasMore);
        }

        function loadMoreTimeline() {
            timelineOffset += TIMELINE_PAGE;
            renderTimelineFull(false);
        }

        /* =========================================================
           ==========  PHASE 3H — REMINDER VIEW (read-only)  =====
           =========================================================
           Read-only VIEW over Calendar events. Shows UPCOMING events
           that have reminderEnabled = true, grouped Today / Tomorrow /
           Later. Reads AppEngine.stats.upcomingEvents({reminderOnly:true})
           (raw), formats here (BM/EN, time, category). No storage, no
           CRUD, no editor of its own. Tapping an item routes to the
           Calendar editor (switchTab -> openCalendarEditor). "Add
           Reminder" opens the Calendar new-event editor.
           ========================================================= */

        // "Add Reminder" — route to Calendar, then open a new event editor.
        // switchTab completes first so the modal opens in the correct tab
        // context (klarifikasi #5), matching the writeTodaysJournal pattern.
        function addReminderFromDashboard() {
            switchTab('calendar');
            openCalendarEditor();   // new event; user enables reminder inside
        }

        // Group helper: 'today' | 'tomorrow' | 'later' for an event's date.
        function reminderGroupOf(e) {
            const today = todayYMD();
            const tomorrow = (function () {
                const d = new Date(); d.setDate(d.getDate() + 1);
                return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
            })();
            if (e.date === today) return 'today';
            if (e.date === tomorrow) return 'tomorrow';
            return 'later';
        }

        function renderReminderView() {
            const listEl = document.getElementById('reminder-list');
            const emptyEl = document.getElementById('reminder-empty');
            if (!listEl) return;

            // Raw, filtered + sorted by the read layer (reminderOnly).
            const events = AppEngine.stats.upcomingEvents({ reminderOnly: true });

            if (events.length === 0) {
                listEl.innerHTML = '';
                listEl.classList.add('hidden');
                emptyEl.classList.remove('hidden');
                return;
            }
            emptyEl.classList.add('hidden');
            listEl.classList.remove('hidden');

            // Grouping is the View's responsibility (not StatsEngine).
            const groups = { today: [], tomorrow: [], later: [] };
            events.forEach(function (e) { groups[reminderGroupOf(e)].push(e); });

            const order = [
                { key: 'today', label: 'rem_group_today' },
                { key: 'tomorrow', label: 'rem_group_tomorrow' },
                { key: 'later', label: 'rem_group_later' }
            ];

            listEl.innerHTML = order.map(function (g) {
                const items = groups[g.key];
                if (!items.length) return '';
                const rows = items.map(function (e) {
                    const cat = (typeof calCat === 'function') ? calCat(e.category) : { icon: 'fa-calendar-check', text: 'text-indigo-400', bg: 'bg-app-lavender/40', key: '' };
                    const timeStr = e.allDay ? journalT('cal_allday_badge') : (e.startTime ? formatClock(e.startTime) : '');
                    const catLabel = cat.key ? journalT(cat.key) : '';
                    const remLabel = reminderOffsetLabel(e);
                    const dateLabel = relativeDayLabel(e);
                    return '' +
                    '<div role="button" tabindex="0" ' +
                        'onclick="openReminderItem(\'' + e.id + '\')" ' +
                        'onkeydown="if(event.key===\'Enter\'||event.key===\' \'){event.preventDefault();openReminderItem(\'' + e.id + '\');}" ' +
                        'class="card-soft p-4 bg-white/80 flex items-center gap-3.5">' +
                        '<div class="w-10 h-10 rounded-full ' + cat.bg + ' ' + cat.text + ' flex items-center justify-center shrink-0"><i class="fa-solid ' + cat.icon + '"></i></div>' +
                        '<div class="flex-1 min-w-0">' +
                            '<p class="font-ui text-sm font-bold text-app-dark truncate">' + escapeHtml(e.title || journalT('tl_untitled')) + '</p>' +
                            '<p class="font-ui text-xs text-gray-500 truncate">' + escapeHtml(catLabel) + (catLabel && timeStr ? ' · ' : '') + escapeHtml(timeStr) + '</p>' +
                            '<p class="font-ui text-[10px] font-semibold text-indigo-400 mt-0.5 flex items-center gap-1"><i class="fa-regular fa-bell"></i> ' + escapeHtml(journalT('rem_reminder_at')) + ': ' + escapeHtml(remLabel) + '</p>' +
                        '</div>' +
                        '<span class="font-ui text-[10px] font-bold uppercase tracking-wider text-gray-400 shrink-0">' + escapeHtml(dateLabel) + '</span>' +
                    '</div>';
                }).join('');

                return '' +
                '<div>' +
                    '<h3 class="font-ui text-[11px] font-bold uppercase tracking-wider text-gray-400 mb-3">' + escapeHtml(journalT(g.label)) + '</h3>' +
                    '<div class="flex flex-col gap-2.5">' + rows + '</div>' +
                '</div>';
            }).join('');
        }

        // Tap a reminder -> edit its event in the Calendar (source editor).
        function openReminderItem(id) {
            switchTab('calendar');
            openCalendarEditor(id);
        }

        /* =========================================================
           ==========  PHASE 4A — PERIOD TRACKER (module)  =======
           =========================================================
           Full module with its own collection (periodRecords) + CRUD
           via AppEngine.data('period'). Source of Truth = periodRecords;
           only this module reads it directly. The Dashboard card reads
           AppEngine.stats.periodStatus() (raw) and formats here. Period
           is EXCLUDED from Timeline (privacy, locked decision).
           ========================================================= */

        const PERIOD_SYMPTOMS = ['cramps','headache','back_pain','fatigue','bloating','mood_changes','breast_tenderness','nausea','other'];
        let periodPendingDeleteId = null;

        function renderPeriodSymptomChips(selected) {
            const box = document.getElementById('periodSymptoms');
            if (!box) return;
            const sel = selected || [];
            box.innerHTML = PERIOD_SYMPTOMS.map(function (s) {
                const on = sel.indexOf(s) !== -1;
                return '<button type="button" data-sym="' + s + '" onclick="togglePeriodSymptom(this)" ' +
                    'class="px-3 py-1.5 rounded-full text-xs font-semibold border transition ' +
                    (on ? 'bg-app-coral text-white border-app-coral' : 'bg-white text-app-text border-app-beige') + '">' +
                    escapeHtml(journalT('period_sym_' + s)) + '</button>';
            }).join('');
        }
        function togglePeriodSymptom(btn) {
            const on = btn.classList.contains('bg-app-coral');
            if (on) { btn.classList.remove('bg-app-coral','text-white','border-app-coral'); btn.classList.add('bg-white','text-app-text','border-app-beige'); }
            else { btn.classList.add('bg-app-coral','text-white','border-app-coral'); btn.classList.remove('bg-white','text-app-text','border-app-beige'); }
        }
        function collectPeriodSymptoms() {
            const box = document.getElementById('periodSymptoms');
            if (!box) return [];
            return Array.prototype.slice.call(box.querySelectorAll('button'))
                .filter(function (b) { return b.classList.contains('bg-app-coral'); })
                .map(function (b) { return b.getAttribute('data-sym'); });
        }

        function openPeriodEditor(id) {
            document.getElementById('periodEditId').value = id || '';
            const delBtn = document.getElementById('periodDeleteBtn');
            if (id) {
                const r = AppEngine.data.get('period', id);
                if (!r) return;
                document.getElementById('periodModalTitle').innerText = journalT('period_modal_edit');
                document.getElementById('periodStart').value = r.startDate || '';
                document.getElementById('periodEnd').value = r.endDate || '';
                document.getElementById('periodFlow').value = r.flow || '';
                document.getElementById('periodNote').value = r.note || '';
                renderPeriodSymptomChips(r.symptoms || []);
                delBtn.classList.remove('hidden');
            } else {
                document.getElementById('periodModalTitle').innerText = journalT('period_modal_new');
                document.getElementById('periodStart').value = todayYMD();
                document.getElementById('periodEnd').value = '';
                document.getElementById('periodFlow').value = '';
                document.getElementById('periodNote').value = '';
                renderPeriodSymptomChips([]);
                delBtn.classList.add('hidden');
            }
            document.getElementById('periodModal').classList.remove('hidden');
        }
        function closePeriodEditor() {
            document.getElementById('periodModal').classList.add('hidden');
        }

        function savePeriodRecord() {
            const start = document.getElementById('periodStart').value;
            const end = document.getElementById('periodEnd').value;
            if (!start) { showToast(journalT('period_err_start')); return; }
            if (end && end < start) { showToast(journalT('period_err_endbefore')); return; }
            const record = {
                startDate: start,
                endDate: end || '',
                flow: document.getElementById('periodFlow').value || '',
                symptoms: collectPeriodSymptoms(),
                note: document.getElementById('periodNote').value.trim()
            };
            const id = document.getElementById('periodEditId').value;
            if (id) {
                AppEngine.data.update('period', id, record);
                showToast(journalT('period_updated'));
            } else {
                AppEngine.data.save('period', record);
                showToast(journalT('period_saved'));
            }
            closePeriodEditor();
            renderPeriodModule();
            updateDashboardPeriodCard();
        }

        function requestDeletePeriod() {
            const id = document.getElementById('periodEditId').value;
            if (!id) return;
            periodPendingDeleteId = id;
            closePeriodEditor();
            document.getElementById('modalTitle').innerText = journalT('period_del_title');
            document.getElementById('modalMessage').innerText = journalT('period_del_desc');
            pendingAction = 'period_delete';
            document.getElementById('customModal').classList.remove('hidden');
        }

        // Cycle summary strip (reads StatsEngine raw; formats here).
        function renderPeriodSummary() {
            const el = document.getElementById('period-summary');
            if (!el) return;
            const st = AppEngine.stats.periodStatus();
            if (!st.tracking) {
                el.innerHTML = '<p class="font-ui text-sm font-semibold text-app-dark">' + escapeHtml(journalT('period_no_record')) + '</p>';
                return;
            }
            const parts = [];
            if (st.isPeriodActive) {
                parts.push('<span class="inline-flex items-center gap-1.5 text-app-coral font-bold"><i class="fa-solid fa-droplet"></i> ' + escapeHtml(journalT('period_active')) + '</span>');
            }
            if (st.cycleDay != null) {
                parts.push('<span class="font-semibold text-app-dark">' + escapeHtml(journalT('period_cycle_day')) + ' ' + st.cycleDay + '</span>');
            }
            if (st.nextPredictedDate) {
                parts.push('<span class="text-gray-500">' + escapeHtml(journalT('period_next_cycle')) + ' ~ ' + escapeHtml(formatJournalDate(st.nextPredictedDate)) + '</span>');
            }
            let html = '<div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">' + parts.join('') + '</div>';
            if (st.predictionBasis === 'default28') {
                html += '<p class="mt-2 text-[10px] text-gray-400">' + escapeHtml(journalT('period_est_note')) + '</p>';
            }
            el.innerHTML = html;
        }

        function renderPeriodList() {
            const listEl = document.getElementById('period-list');
            const emptyEl = document.getElementById('period-empty');
            const summaryEl = document.getElementById('period-summary');
            if (!listEl) return;
            const recs = AppEngine.data.get('period')
                .filter(function (r) { return r.startDate; })
                .sort(function (a, b) { return (parseLocalYMD(b.startDate) || 0) - (parseLocalYMD(a.startDate) || 0); });

            if (recs.length === 0) {
                listEl.innerHTML = '';
                listEl.classList.add('hidden');
                emptyEl.classList.remove('hidden');
                if (summaryEl) summaryEl.classList.add('hidden');
                return;
            }
            emptyEl.classList.add('hidden');
            listEl.classList.remove('hidden');
            if (summaryEl) summaryEl.classList.remove('hidden');

            listEl.innerHTML = recs.map(function (r) {
                const dateRange = formatJournalDate(r.startDate) + (r.endDate ? ' – ' + formatJournalDate(r.endDate) : '');
                const flow = r.flow ? '<span class="text-[10px] font-bold uppercase tracking-wider text-app-coral">' + escapeHtml(journalT('period_flow_' + r.flow)) + '</span>' : '';
                const syms = (r.symptoms && r.symptoms.length)
                    ? '<p class="text-xs text-gray-500 mt-1">' + r.symptoms.map(function (s) { return escapeHtml(journalT('period_sym_' + s)); }).join(', ') + '</p>'
                    : '';
                const note = r.note ? '<p class="text-xs text-gray-400 mt-1">' + escapeHtml(r.note) + '</p>' : '';
                return '' +
                '<div role="button" tabindex="0" onclick="openPeriodEditor(\'' + r.id + '\')" ' +
                    'onkeydown="if(event.key===\'Enter\'||event.key===\' \'){event.preventDefault();openPeriodEditor(\'' + r.id + '\');}" ' +
                    'class="card-soft p-4 bg-white/80 flex items-start gap-3.5">' +
                    '<div class="w-10 h-10 rounded-full bg-red-50 text-app-coral flex items-center justify-center shrink-0"><i class="fa-solid fa-droplet"></i></div>' +
                    '<div class="flex-1 min-w-0">' +
                        '<div class="flex items-center justify-between gap-2">' +
                            '<p class="font-ui text-sm font-bold text-app-dark">' + escapeHtml(dateRange) + '</p>' + flow +
                        '</div>' + syms + note +
                    '</div>' +
                '</div>';
            }).join('');
        }

        function renderPeriodModule() {
            renderPeriodSummary();
            renderPeriodList();
        }

        // Dashboard card — summary only (locked): Cycle Day + Next Cycle.
        // Never flow/symptoms/notes. Reads StatsEngine (raw), formats here.
        function updateDashboardPeriodCard() {
            const el = document.getElementById('dash-period');
            if (!el) return;
            const st = AppEngine.stats.periodStatus();
            if (!st.tracking) {
                el.innerText = journalT('period_no_record');
                return;
            }
            const bits = [];
            if (st.cycleDay != null) bits.push(journalT('period_cycle_day') + ' ' + st.cycleDay);
            if (st.nextPredictedDate) bits.push(journalT('period_next_cycle') + ' ~ ' + formatJournalDate(st.nextPredictedDate));
            el.innerText = bits.length ? bits.join(' · ') : journalT('period_tracking_started');
        }

        /* =========================================================
           ==========  PHASE 4B-2 — THEME CARDS (Settings)  ======
           =========================================================
           Renders 5 theme cards with palette preview. Tapping a card
           live-switches the theme (AppEngine.theme.setTheme auto-saves),
           updates the active check, no Save button. Read-only view over
           ThemeEngine.palettes — no storage/CRUD of its own.
           ========================================================= */
        function selectTheme(key) {
            AppEngine.theme.setTheme(key);   // applies + saves + re-renders cards
        }

        function renderThemeCards() {
            const box = document.getElementById('theme-cards');
            if (!box || !window.AppEngine) return;
            const palettes = AppEngine.theme.palettes;
            const active = AppEngine.theme.current();
            box.innerHTML = Object.keys(palettes).map(function (key) {
                const p = palettes[key];
                const isActive = key === active;
                const swatches = p.swatches.map(function (c) {
                    return '<span class="inline-block w-5 h-5 rounded-full border border-black/5" style="background:' + c + '"></span>';
                }).join('');
                const check = isActive
                    ? '<span class="absolute top-3 right-3 w-6 h-6 rounded-full bg-app-rose text-white flex items-center justify-center text-xs"><i class="fa-solid fa-check"></i></span>'
                    : '';
                const ring = isActive ? 'border-app-rose ring-2 ring-app-rose/40' : 'border-app-beige hover:border-app-rose/50';
                return '' +
                '<div role="button" tabindex="0" ' +
                    'onclick="selectTheme(\'' + key + '\')" ' +
                    'onkeydown="if(event.key===\'Enter\'||event.key===\' \'){event.preventDefault();selectTheme(\'' + key + '\');}" ' +
                    'class="relative bg-white border-2 ' + ring + ' rounded-2xl p-4 cursor-pointer transition-all">' +
                    check +
                    '<div class="flex items-center gap-2 mb-1">' +
                        '<i class="fa-solid ' + p.icon + ' text-app-rose"></i>' +
                        '<h4 class="font-ui text-sm font-bold text-app-dark">' + escapeHtml(p.label) + '</h4>' +
                    '</div>' +
                    '<p class="font-ui text-[11px] text-gray-400 mb-3">' + escapeHtml(p.mood) + '</p>' +
                    '<div class="flex items-center gap-1.5">' + swatches + '</div>' +
                '</div>';
            }).join('');
        }

        window.onload = initApp;
    </script>
</body>
</html>
