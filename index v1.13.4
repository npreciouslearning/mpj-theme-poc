    <style>
        /* ==========================================
           0. DESIGN TOKENS (Phase 4B-1)
           Semantic tokens as RGB CHANNELS (not hex) so Tailwind
           opacity modifiers (e.g. bg-app-rose/20) work via
           rgb(var(--token) / <alpha-value>). Values below reproduce
           the v1.11.0 blush baseline exactly — the app must look
           identical after this migration. Category colours are NOT
           tokenized (they carry semantic meaning across themes).
           ========================================== */
        :root {
            /* Backgrounds */
            --bg-primary: 253 251 247;    /* #FDFBF7 cream */
            --card-bg: 255 255 255;       /* #FFFFFF white */
            /* Text */
            --text-primary: 45 45 45;     /* #2D2D2D dark */
            --text-secondary: 74 74 74;   /* #4A4A4A text */
            /* Brand */
            --primary: 210 167 165;       /* #D2A7A5 rose */
            --primary-soft: 244 227 228;  /* #F4E3E4 blush */
            --primary-dark: 182 141 139;  /* #B68D8B rose-dark/hover */
            --accent: 212 175 55;         /* #D4AF37 gold */
            /* Structure */
            --border: 235 227 213;        /* #EBE3D5 beige */
            /* Neutral palette accents (used across UI, not category) */
            --tone-sage: 193 205 180;     /* #C1CDB4 */
            --tone-lavender: 217 215 232; /* #D9D7E8 */
            --tone-green: 181 201 179;    /* #B5C9B3 */
            --tone-blue: 197 214 224;     /* #C5D6E0 */
            /* Shadow tint (rose) + radius */
            --shadow-tint: 210 167 165;   /* rose, for card hover glow */
            --radius: 1.5rem;
            /* Fonts */
            --font-heading: 'DM Serif Display', serif;
            --font-ui: 'Poppins', sans-serif;
            --font-body: 'Nunito Sans', sans-serif;
            --font-signature: 'Caveat', cursive;
        }

        /* ==========================================
           1. TYPOGRAPHY SYSTEM
           ========================================== */
        body {
            font-family: var(--font-body);
            background-color: rgb(var(--bg-primary));
            color: rgb(var(--text-secondary));
            -webkit-font-smoothing: antialiased;
        }

        h1, h2, .font-display {
            font-family: var(--font-heading);
        }

        h3, h4, button, nav, label, .font-ui {
            font-family: var(--font-ui);
        }

        .font-signature {
            font-family: var(--font-signature);
        }

        /* ==========================================
           2. GLASSMORPHISM & CARD STYLING
           ========================================== */
        .glass-card {
            background: rgba(255, 255, 255, 0.75);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.6);
            box-shadow: 0 10px 40px -10px rgba(74, 74, 74, 0.04);
        }

        .card-soft {
            border-radius: var(--radius);
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.9);
            background: rgb(var(--card-bg));
            cursor: pointer;
        }

        .card-soft:hover {
            box-shadow: 0 12px 35px rgb(var(--shadow-tint) / 0.18);
            transform: translateY(-2px);
        }

        .card-soft:active {
            transform: scale(0.98);
        }

        /* Watercolor Signature Highlight */
        .signature-highlight {
            position: relative;
            display: inline-block;
        }
        .signature-highlight::before {
            content: '';
            position: absolute;
            inset: -2px -10px;
            background: linear-gradient(135deg, rgba(244, 227, 228, 0.45), rgba(253, 246, 238, 0.75));
            border-radius: 255px 15px 225px 15px/15px 225px 15px 255px;
            transform: rotate(-3deg);
            z-index: 0;
            filter: blur(0.4px);
            opacity: 0.8;
        }

        /* ==========================================
           3. NAVIGATION
           ========================================== */
        .hide-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .hide-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        .nav-btn {
            position: relative;
            overflow: hidden;
            border: 1px solid rgb(var(--border));
            cursor: pointer;
        }
        .nav-icon-container {
            transition: transform 0.3s ease, background-color 0.3s ease;
        }
        .nav-btn.active {
            background-color: rgb(var(--primary));
            color: #FFFFFF;
            border-color: rgb(var(--primary));
            box-shadow: 0 4px 15px rgb(var(--primary) / 0.25);
        }
        .nav-btn.active .nav-icon-container {
            background-color: rgba(255, 255, 255, 0.25);
            transform: scale(1.05);
        }
        .nav-btn:not(.active):hover {
            background-color: rgb(var(--primary-soft) / 0.3);
        }

        /* ==========================================
           4. UI ELEMENTS
           ========================================== */
        .toggle-checkbox:checked {
            right: 0;
            border-color: rgb(var(--primary));
        }
        .toggle-checkbox:checked + .toggle-label {
            background-color: rgb(var(--primary));
        }

        #toast {
            visibility: hidden;
            min-width: 250px;
            background-color: rgb(var(--text-primary));
            color: #fff;
            text-align: center;
            border-radius: 14px;
            padding: 14px 24px;
            position: fixed;
            z-index: 200;
            left: 50%;
            bottom: 30px;
            transform: translateX(-50%);
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
            font-family: 'Poppins', sans-serif;
            font-size: 0.85rem;
            font-weight: 500;
        }
        #toast.show {
            visibility: visible;
            animation: fadein 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards, fadeout 0.4s 2.5s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        }
        @keyframes fadein {
            from {bottom: 0; opacity: 0; transform: translate(-50%, 15px);}
            to {bottom: 30px; opacity: 1; transform: translate(-50%, 0);}
        }
        @keyframes fadeout {
            from {bottom: 30px; opacity: 1; transform: translate(-50%, 0);}
            to {bottom: 0; opacity: 0; transform: translate(-50%, 15px);}
        }

        .animate-fade-in {
            animation: fadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
