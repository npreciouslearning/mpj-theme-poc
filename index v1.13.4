        function initApp() {
            document.getElementById('loadingOverlay').style.display = 'flex';
            setTimeout(() => {
                loadData();
                if (window.AppEngine && window.AppEngine.theme) window.AppEngine.theme.applyToRoot();
                applyLanguage(appData.settings.language);
                updateUIBasedOnData();
                switchTab('dashboard', false);
                updateDashboardDateAndHero();
                // Phase 3E: ensure reminder card populated + run a safe
                // in-app reminder scan (no push, no interval).
                if (typeof updateDashboardReminderCard === 'function') updateDashboardReminderCard();
                if (typeof updateDashboardPeriodCard === 'function') updateDashboardPeriodCard();
                if (typeof runInAppReminderScan === 'function') runInAppReminderScan();
                document.getElementById('loadingOverlay').style.display = 'none';
            }, 300);
        }

        function loadData() {
            const rawData = localStorage.getItem(STORAGE_KEY);
            if (rawData) {
                try {
                    const savedData = JSON.parse(rawData);
                    appData = {
                        ...defaultData,
                        ...savedData,
                        settings: {
                            ...defaultData.settings,
                            ...(savedData.settings || {})
                        },
                        profile: {
                            ...defaultData.profile,
                            ...(savedData.profile || {})
                        }
                    };
                } catch (e) {
                    appData = JSON.parse(JSON.stringify(defaultData));
                }
            } else {
                appData = JSON.parse(JSON.stringify(defaultData));
            }
        }

        function saveDataToLocal() {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(appData));
        }

        // Helper: day-of-year (1-366) so the Quote of the Day rotates across
        // the whole year instead of repeating every calendar month.
        function getDayOfYear(date) {
            const start = new Date(date.getFullYear(), 0, 0);
            const diff = date - start;
            return Math.floor(diff / 86400000);
        }

        function switchTab(tabId, addToHistory = true) {
            // Avoid duplicate consecutive entries if clicking the same tab
            if (addToHistory && currentTab !== tabId) {
                tabHistory.push(currentTab);
            }
            currentTab = tabId;

            document.querySelectorAll('.module-view').forEach(view => {
                view.classList.add('hidden');
                view.classList.remove('animate-fade-in');
            });
            
            const activeView = document.getElementById(`view-${tabId}`);
            if(activeView) {
                activeView.classList.remove('hidden');
                void activeView.offsetWidth; 
                activeView.classList.add('animate-fade-in');
            }

            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('active');
                const iconContainer = btn.querySelector('.nav-icon-container');
                if(iconContainer) {
                    iconContainer.classList.remove('bg-white/25');
                    iconContainer.classList.add('bg-app-cream');
                }
            });

            const activeBtn = document.getElementById(`nav-${tabId}`);
            if(activeBtn) {
                activeBtn.classList.add('active');
                const activeIconContainer = activeBtn.querySelector('.nav-icon-container');
                if(activeIconContainer) {
                    activeIconContainer.classList.remove('bg-app-cream');
                    activeIconContainer.classList.add('bg-white/25');
                }
                activeBtn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            }

            // Update Back Button Visibility
            updateBackButton();

            // Module-specific refresh on entry (Journal — Phase 3B).
            if (tabId === 'journal' && typeof renderJournalList === 'function') {
                renderJournalList();
            }
            // Module-specific refresh on entry (Mood — Phase 3C).
            if (tabId === 'mood' && typeof renderMoodList === 'function') {
                renderMoodList();
            }
            // Module-specific refresh on entry (Money — Phase 3D).
            if (tabId === 'money' && typeof renderMoneyList === 'function') {
                renderMoneyList();
            }
            // Module-specific refresh on entry (Calendar — Phase 3E).
            if (tabId === 'calendar' && typeof renderCalendarModule === 'function') {
                renderCalendarModule();
            }
            // Dashboard: refresh Recent Journey timeline (Phase 3G).
            if (tabId === 'dashboard' && typeof renderDashboardTimeline === 'function') {
                renderDashboardTimeline();
            }
            // Reminder View: refresh on entry (Phase 3H).
            if (tabId === 'reminder' && typeof renderReminderView === 'function') {
                renderReminderView();
            }
            // Period module: refresh on entry (Phase 4A).
            if (tabId === 'period' && typeof renderPeriodModule === 'function') {
                renderPeriodModule();
            }

            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        }

        function goBack() {
            if (tabHistory.length > 0) {
                const prevTab = tabHistory.pop();
                // Switch tab without pushing to history stack
                switchTab(prevTab, false);
            } else {
                switchTab('dashboard', false);
            }
        }

        // Centralised Back Button visibility logic (single source of truth)
        function updateBackButton() {
            const backBtn = document.getElementById('backBtn');
            if (!backBtn) return;
            if (tabHistory.length > 0 && currentTab !== 'dashboard') {
                backBtn.classList.remove('hidden');
                backBtn.classList.add('flex');
            } else {
                backBtn.classList.remove('flex');
                backBtn.classList.add('hidden');
            }
        }

        function handleCardKey(event, tabName) {
            if (event.key === 'Enter' || event.key === ' ') {
                event.preventDefault();
                switchTab(tabName);
            }
        }

        function setLanguage(lang) {
            appData.settings.language = lang;
            saveDataToLocal();
            // applyLanguage() already re-renders the dashboard/hero
            // (and quote), so no extra updateDashboardDateAndHero() here.
            applyLanguage(lang);
        }

        function applyLanguage(lang) {
            currentLang = lang;
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (translations[lang] && translations[lang][key] !== undefined) {
                    el.innerText = translations[lang][key];
                }
            });

            // Translate placeholders (inputs/textareas) via data-i18n-ph.
            document.querySelectorAll('[data-i18n-ph]').forEach(el => {
                const key = el.getAttribute('data-i18n-ph');
                if (translations[lang] && translations[lang][key] !== undefined) {
                    el.setAttribute('placeholder', translations[lang][key]);
                }
            });

            document.getElementById('lang-ms').className = lang === 'ms' 
                ? 'font-ui px-4 py-1.5 rounded-xl text-xs font-semibold transition-all duration-300 ease-out bg-app-primary text-white shadow-[0_2px_10px_rgb(var(--primary)/0.45)] focus:outline-none' 
                : 'font-ui px-4 py-1.5 rounded-xl text-xs font-semibold transition-all duration-300 ease-out text-app-text hover:bg-white focus:outline-none';
            document.getElementById('lang-en').className = lang === 'en' 
                ? 'font-ui px-4 py-1.5 rounded-xl text-xs font-semibold transition-all duration-300 ease-out bg-app-primary text-white shadow-[0_2px_10px_rgb(var(--primary)/0.45)] focus:outline-none' 
                : 'font-ui px-4 py-1.5 rounded-xl text-xs font-semibold transition-all duration-300 ease-out text-app-text hover:bg-white focus:outline-none';

            updateDashboardDateAndHero();
            updateUIBasedOnData();

            // Re-render the journal list so entry labels/moods follow language.
            if (typeof renderJournalList === 'function') {
                renderJournalList();
            }
            // Re-render mood list, select options and dashboard mood card.
            if (typeof renderMoodList === 'function') {
                renderMoodList();
            }
            if (typeof renderMoodSelectOptions === 'function') {
                renderMoodSelectOptions();
            }
            if (typeof updateDashboardMoodCard === 'function') {
                updateDashboardMoodCard();
            }
            // Re-render money list, summary and dashboard money cards
            // (category labels & currency follow language).
            if (typeof renderMoneyList === 'function') {
                renderMoneyList();
            }
            if (typeof updateDashboardMoneyCards === 'function') {
                updateDashboardMoneyCards();
            }
            // Re-render calendar (labels, weekday/month names) + reminder card.
            if (typeof renderCalendarModule === 'function') {
                renderCalendarModule();
            }
            if (typeof updateDashboardReminderCard === 'function') {
                updateDashboardReminderCard();
            }
            // Re-render dashboard Recent Journey (labels follow language).
            if (typeof renderDashboardTimeline === 'function') {
                renderDashboardTimeline();
            }
            // Re-render Reminder View (labels/groups follow language).
            if (typeof renderReminderView === 'function') {
                renderReminderView();
            }
            // Re-render Period module + dashboard card (labels follow language).
            if (typeof renderPeriodModule === 'function') {
                renderPeriodModule();
            }
            if (typeof updateDashboardPeriodCard === 'function') {
                updateDashboardPeriodCard();
            }
        }

        function updateUIBasedOnData() {
            document.getElementById('userName').value = appData.profile.name || '';
            if (typeof renderThemeCards === 'function') renderThemeCards();
            const curSel = document.getElementById('userCurrency');
            if (curSel) curSel.value = appData.settings.currency || 'RM';
            document.getElementById('togglePregnancy').checked = appData.settings.pregnancyEnabled;

            const pregStatusCard = document.getElementById('dash-preg-status');
            const pregDisabledView = document.getElementById('preg-disabled-state');
            const pregEnabledView = document.getElementById('preg-enabled-state');

            if (appData.settings.pregnancyEnabled) {
                pregStatusCard.innerText = translations[currentLang]['dash_val_active'];
                pregStatusCard.classList.remove('text-gray-400');
                pregStatusCard.classList.add('text-app-rose');
                if(pregDisabledView) pregDisabledView.classList.add('hidden');
                if(pregEnabledView) pregEnabledView.classList.remove('hidden');
            } else {
                pregStatusCard.innerText = translations[currentLang]['dash_val_not_active'];
                pregStatusCard.classList.remove('text-app-rose');
                pregStatusCard.classList.add('text-gray-400');
                if(pregDisabledView) pregDisabledView.classList.remove('hidden');
                if(pregEnabledView) pregEnabledView.classList.add('hidden');
            }
        }

        function updateDashboardDateAndHero() {
            const date = new Date();
            
            const options = { day: '2-digit', month: 'short', year: 'numeric' };
            const todayStr = date.toLocaleDateString(currentLang === 'ms' ? 'ms-MY' : 'en-GB', options);
            document.getElementById('dash-date').innerText = todayStr;

            const dayNum = date.getDate().toString().padStart(2, '0');
            const monthYear = date.toLocaleDateString(currentLang === 'ms' ? 'ms-MY' : 'en-GB', { month: 'short', year: 'numeric' });
            const dayName = date.toLocaleDateString(currentLang === 'ms' ? 'ms-MY' : 'en-GB', { weekday: 'long' });
            
            document.getElementById('hero-day-num').innerText = dayNum;
            document.getElementById('hero-month-year').innerText = monthYear;
            document.getElementById('hero-day-name').innerText = dayName;

            const hour = date.getHours();
            let greetingKey = 'greet_morning';
            if (hour >= 12 && hour < 18) greetingKey = 'greet_afternoon';
            else if (hour >= 18) greetingKey = 'greet_evening';
            
            const greetingText = translations[currentLang][greetingKey];
            const nameInput = appData.profile.name ? appData.profile.name.trim() : '';
            
            let displayName = "";
            if (nameInput !== "") {
                displayName = nameInput;
            } else {
                displayName = translations[currentLang]['greet_default_name'];
            }
            
            document.getElementById('hero-greeting-text').innerText = `${greetingText},`;
            const sigEl = document.getElementById('hero-name-signature');
            if (displayName === "") {
                sigEl.style.display = "none";
            } else {
                sigEl.style.display = "inline-block";
                sigEl.innerText = displayName;
            }

            // Quote of the Day: rotate by day-of-year so it stays fixed for the
            // whole day and only changes when the date changes. Both languages
            // share the same index. Safe fallback if the array is empty.
            const quoteList = currentLang === 'ms' ? quotesMS : quotesEN;
            let quoteStr;
            if (quoteList && quoteList.length > 0) {
                const quoteIndex = getDayOfYear(date) % quoteList.length;
                quoteStr = quoteList[quoteIndex];
            } else {
                quoteStr = currentLang === 'ms'
                    ? "Setiap hari ialah permulaan baharu."
                    : "Every day is a fresh beginning.";
            }
            document.getElementById('hero-quote').innerText = `"${quoteStr}"`;
        }

        function handlePregnancyToggle() {
            const isEnabled = document.getElementById('togglePregnancy').checked;
            appData.settings.pregnancyEnabled = isEnabled;
            saveDataToLocal();
            updateUIBasedOnData();
        }

        function saveSettings() {
            appData.profile.name = document.getElementById('userName').value.trim();
            // Theme is handled live by the theme cards (setTheme auto-saves).
            const curSel = document.getElementById('userCurrency');
            if (curSel) appData.settings.currency = curSel.value;
            saveDataToLocal();
            // Re-assert current theme (harmless; keeps CSS vars in sync).
            if (window.AppEngine && window.AppEngine.theme) {
                window.AppEngine.theme.applyToRoot();
            }
            updateUIBasedOnData();
            updateDashboardDateAndHero();
            // Currency may have changed — refresh money displays.
            if (typeof renderMoneyList === 'function') renderMoneyList();
            if (typeof updateDashboardMoneyCards === 'function') updateDashboardMoneyCards();
            showToast(translations[currentLang]['msg_saved']);
        }

        function confirmAction(action, event = null) {
            pendingAction = action;
            if (event) pendingEvent = event;
            
            document.getElementById('modalTitle').innerText = translations[currentLang]['modal_conf_title'];
            document.getElementById('modalMessage').innerText = translations[currentLang]['modal_conf_desc'];
            document.getElementById('customModal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('customModal').classList.add('hidden');
            pendingAction = null;
            pendingEvent = null;
            journalPendingDeleteId = null;
            moodPendingDeleteId = null;
            moneyPendingDeleteId = null;
            calendarPendingDeleteId = null;
            periodPendingDeleteId = null;
            document.getElementById('importJsonInput').value = ''; 
        }

        document.getElementById('modalConfirmBtn').addEventListener('click', () => {
            if (pendingAction === 'export') {
                processExport();
            } else if (pendingAction === 'import') {
                processImport(pendingEvent);
            } else if (pendingAction === 'reset') {
                processReset();
            } else if (pendingAction === 'journal_delete') {
                if (journalPendingDeleteId) {
                    AppEngine.data.delete('journal', journalPendingDeleteId);
                    journalPendingDeleteId = null;
                    renderJournalList();
                    showToast(translations[currentLang]['journal_deleted']);
                }
            } else if (pendingAction === 'mood_delete') {
                if (moodPendingDeleteId) {
                    AppEngine.data.delete('mood', moodPendingDeleteId);
                    moodPendingDeleteId = null;
                    renderMoodList();
                    updateDashboardMoodCard();
                    showToast(translations[currentLang]['mood_deleted']);
                }
            } else if (pendingAction === 'money_delete') {
                if (moneyPendingDeleteId) {
                    AppEngine.data.delete('money', moneyPendingDeleteId);
                    moneyPendingDeleteId = null;
                    renderMoneyList();
                    updateDashboardMoneyCards();
                    showToast(translations[currentLang]['money_deleted']);
                }
            } else if (pendingAction === 'calendar_delete') {
                if (calendarPendingDeleteId) {
                    AppEngine.data.delete('calendar', calendarPendingDeleteId);
                    calendarPendingDeleteId = null;
                    renderCalendarModule();
                    updateDashboardReminderCard();
                    showToast(translations[currentLang]['cal_deleted']);
                }
            } else if (pendingAction === 'period_delete') {
                if (periodPendingDeleteId) {
                    AppEngine.data.delete('period', periodPendingDeleteId);
                    periodPendingDeleteId = null;
                    renderPeriodModule();
                    updateDashboardPeriodCard();
                    showToast(translations[currentLang]['period_deleted']);
                }
            }
            closeModal();
        });

        function processExport() {
            const dataStr = JSON.stringify(appData, null, 2);
            const blob = new Blob([dataStr], { type: "application/json" });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `MyPersonalJourney_Backup_${new Date().toISOString().slice(0,10)}.json`;
            a.click();
            URL.revokeObjectURL(url);
            showToast(translations[currentLang]['msg_exported']);
        }

        function processImport(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const importedData = JSON.parse(e.target.result);
                    if (importedData && typeof importedData === 'object') {
                        appData = {
                            ...defaultData,
                            ...importedData,
                            settings: {
                                ...defaultData.settings,
                                ...(importedData.settings || {})
                            },
                            profile: {
                                ...defaultData.profile,
                                ...(importedData.profile || {})
                            }
                        };
                        saveDataToLocal();
                        if (window.AppEngine && window.AppEngine.theme) window.AppEngine.theme.applyToRoot();
                        // Re-apply language from the imported data (falls back to
                        // current language if the imported value is not valid).
                        const importedLang = translations[appData.settings.language]
                            ? appData.settings.language
                            : currentLang;
                        appData.settings.language = importedLang;
                        applyLanguage(importedLang);
                        updateUIBasedOnData();
                        updateDashboardDateAndHero();
                        showToast(translations[currentLang]['msg_imported']);
                    }
                } catch (error) {
                    showToast(translations[currentLang]['err_import']);
                }
            };
            reader.readAsText(file);
        }

        function processReset() {
            appData = JSON.parse(JSON.stringify(defaultData));
            saveDataToLocal();
            if (window.AppEngine && window.AppEngine.theme) window.AppEngine.theme.applyToRoot();
            applyLanguage(appData.settings.language);
            updateUIBasedOnData();
            updateDashboardDateAndHero();
            showToast(translations[currentLang]['msg_reset']);
        }

        function showToast(message) {
            const toast = document.getElementById("toast");
            toast.innerText = message;
            toast.className = "show";
            setTimeout(function(){ toast.className = toast.className.replace("show", ""); }, 3000);
        }

        /* =========================================================
           ==========  PHASE 3A — CORE ENGINE LAYER  ==============
           =========================================================
           Backend-only. Does NOT touch UI, markup, colors, layout
           or any existing function. Every engine reads/writes the
           SAME appData object and the SAME STORAGE_KEY already in
           use, then calls the existing saveDataToLocal(). Future
           modules (Journal, Money, Reminder, Islamic, Vault...)
           reuse these shared helpers instead of writing their own
           CRUD / search / stats / notifications / theming.
           ========================================================= */
        (function () {
            'use strict';

            /* ----- Shared low-level helpers (no duplication) ------ */

            // Map a logical "collection name" to the actual array key
            // inside appData. New modules only need one line added here.
            const COLLECTIONS = {
                journal:      'journal',
                mood:         'moods',
                money:        'transactions',
                calendar:     'events',
                reminder:     'reminders',
                period:       'periodRecords',
                pregnancy:    'pregnancyRecords',
                notes:        'notes',
                islamic:      'islamicRecords',      // future (Phase 9)
                vault:        'documentVault'        // future (Phase 10)
            };

            // Generate a unique-enough id without external libraries.
            function makeId() {
                return 'id_' + Date.now().toString(36) + '_' +
                    Math.random().toString(36).slice(2, 8);
            }

            function nowISO() {
                return new Date().toISOString();
            }

            // Guarantee the target array exists on appData (self-healing
            // for imported/old backups that predate a collection).
            function ensureCollection(name) {
                const key = COLLECTIONS[name];
                if (!key) {
                    throw new Error('Unknown collection: ' + name);
                }
                if (!Array.isArray(appData[key])) {
                    appData[key] = [];
                }
                return appData[key];
            }

            // Read a nested value by dot-path, e.g. field('a.b', obj).
            function readPath(obj, path) {
                if (!path) return obj;
                return path.split('.').reduce(function (acc, k) {
                    return (acc == null) ? undefined : acc[k];
                }, obj);
            }

            // Case-insensitive "contains" across all string values of an
            // object (used by search). Recurses into nested objects/arrays.
            function objectMatchesText(obj, needleLower) {
                if (obj == null) return false;
                if (typeof obj === 'string') {
                    return obj.toLowerCase().indexOf(needleLower) !== -1;
                }
                if (typeof obj === 'number' || typeof obj === 'boolean') {
                    return String(obj).toLowerCase().indexOf(needleLower) !== -1;
                }
                if (Array.isArray(obj)) {
                    return obj.some(function (v) { return objectMatchesText(v, needleLower); });
                }
                if (typeof obj === 'object') {
                    return Object.keys(obj).some(function (k) {
                        return objectMatchesText(obj[k], needleLower);
                    });
                }
                return false;
            }

            /* =====================================================
               1) DATA MANAGER  —  one CRUD system for every module
               ===================================================== */
            const DataManager = {
                // CREATE / SAVE. Returns the stored record (with id + meta).
                save: function (collection, record) {
                    const arr = ensureCollection(collection);
                    const item = Object.assign({}, record);
                    if (!item.id) item.id = makeId();
                    if (!item.createdAt) item.createdAt = nowISO();
                    item.updatedAt = nowISO();
                    arr.push(item);
                    saveDataToLocal();
                    return item;
                },

                // READ one by id (or the whole collection if id omitted).
                get: function (collection, id) {
                    const arr = ensureCollection(collection);
                    if (id === undefined || id === null) {
                        return arr.slice();          // shallow copy = safe read
                    }
                    return arr.find(function (r) { return r.id === id; }) || null;
                },

                // UPDATE by id with a partial patch. Returns updated record.
                update: function (collection, id, patch) {
                    const arr = ensureCollection(collection);
                    const idx = arr.findIndex(function (r) { return r.id === id; });
                    if (idx === -1) return null;
                    arr[idx] = Object.assign({}, arr[idx], patch, {
                        id: arr[idx].id,
                        createdAt: arr[idx].createdAt,
                        updatedAt: nowISO()
                    });
                    saveDataToLocal();
                    return arr[idx];
                },

                // PATCH METADATA without bumping updatedAt (or id/createdAt).
                // Use for silent flags like favorite/archived so list
                // ordering by updatedAt is not disturbed. Does not alter
                // the behaviour of update() used by other modules.
                patchMeta: function (collection, id, patch) {
                    const arr = ensureCollection(collection);
                    const idx = arr.findIndex(function (r) { return r.id === id; });
                    if (idx === -1) return null;
                    const preserved = {
                        id: arr[idx].id,
                        createdAt: arr[idx].createdAt,
                        updatedAt: arr[idx].updatedAt
                    };
                    arr[idx] = Object.assign({}, arr[idx], patch, preserved);
                    saveDataToLocal();
                    return arr[idx];
                },

                // DELETE by id. Returns true if something was removed.
                delete: function (collection, id) {
                    const arr = ensureCollection(collection);
                    const idx = arr.findIndex(function (r) { return r.id === id; });
                    if (idx === -1) return false;
                    arr.splice(idx, 1);
                    saveDataToLocal();
                    return true;
                },

                // SEARCH within one collection (free text over all fields).
                search: function (collection, query) {
                    const arr = ensureCollection(collection);
                    if (!query) return arr.slice();
                    const needle = String(query).toLowerCase();
                    return arr.filter(function (r) {
                        return objectMatchesText(r, needle);
                    });
                },

                // FILTER by an object of field:value or a predicate function.
                filter: function (collection, predicate) {
                    const arr = ensureCollection(collection);
                    if (typeof predicate === 'function') {
                        return arr.filter(predicate);
                    }
                    if (predicate && typeof predicate === 'object') {
                        const keys = Object.keys(predicate);
                        return arr.filter(function (r) {
                            return keys.every(function (k) {
                                return readPath(r, k) === predicate[k];
                            });
                        });
                    }
                    return arr.slice();
                },

                // SORT by field (dot-path). dir: 'asc' (default) | 'desc'.
                sort: function (collection, field, dir) {
                    const arr = ensureCollection(collection).slice();
                    const factor = (dir === 'desc') ? -1 : 1;
                    arr.sort(function (a, b) {
                        const av = readPath(a, field);
                        const bv = readPath(b, field);
                        if (av == null && bv == null) return 0;
                        if (av == null) return -1 * factor;
                        if (bv == null) return 1 * factor;
                        if (av < bv) return -1 * factor;
                        if (av > bv) return 1 * factor;
                        return 0;
                    });
                    return arr;
                },

                // Utility: list all known collection names.
                collections: function () {
                    return Object.keys(COLLECTIONS);
                }
            };

            /* =====================================================
               2) SEARCH ENGINE  —  one search across ALL modules
               ===================================================== */
            const SearchEngine = {
                // Search every collection (or a given subset). Returns an
                // array of { collection, item } hits.
                globalSearch: function (query, collectionSubset) {
                    const results = [];
                    if (!query) return results;
                    const needle = String(query).toLowerCase();
                    const names = collectionSubset && collectionSubset.length
                        ? collectionSubset
                        : Object.keys(COLLECTIONS);
                    names.forEach(function (name) {
                        const arr = ensureCollection(name);
                        arr.forEach(function (item) {
                            if (objectMatchesText(item, needle)) {
                                results.push({ collection: name, item: item });
                            }
                        });
                    });
                    return results;
                }
            };

            /* =====================================================
               3) STATISTICS ENGINE  —  dashboard reads, never counts
               ===================================================== */
            const StatsEngine = {
                count: function (collection) {
                    return ensureCollection(collection).length;
                },

                // Sum a numeric field across a collection (optionally filtered).
                sum: function (collection, field, predicate) {
                    let arr = ensureCollection(collection);
                    if (predicate) arr = DataManager.filter(collection, predicate);
                    return arr.reduce(function (total, r) {
                        const v = Number(readPath(r, field));
                        return total + (isNaN(v) ? 0 : v);
                    }, 0);
                },

                // Records whose date field falls in the current calendar month.
                inCurrentMonth: function (collection, dateField) {
                    const now = new Date();
                    const y = now.getFullYear();
                    const m = now.getMonth();
                    return ensureCollection(collection).filter(function (r) {
                        const raw = readPath(r, dateField);
                        if (!raw) return false;
                        const d = new Date(raw);
                        return !isNaN(d) && d.getFullYear() === y && d.getMonth() === m;
                    });
                },

                // Money helper — expects transactions with { type, amount, date }.
                monthlyMoney: function () {
                    const month = this.inCurrentMonth('money', 'date');
                    let income = 0, expense = 0;
                    month.forEach(function (t) {
                        const amt = Number(t.amount) || 0;
                        if (t.type === 'income') income += amt;
                        else if (t.type === 'expense') expense += amt;
                    });
                    return { income: income, expense: expense, savings: income - expense };
                },

                // Was there a record for a collection dated "today"?
                hasRecordToday: function (collection, dateField) {
                    const today = new Date().toDateString();
                    return ensureCollection(collection).some(function (r) {
                        const raw = readPath(r, dateField);
                        if (!raw) return false;
                        const d = new Date(raw);
                        return !isNaN(d) && d.toDateString() === today;
                    });
                },

                // Generic snapshot the dashboard can render directly later.
                dashboardSnapshot: function () {
                    return {
                        counts: {
                            journal:   this.count('journal'),
                            mood:      this.count('mood'),
                            money:     this.count('money'),
                            reminder:  this.count('reminder'),
                            notes:     this.count('notes'),
                            period:    this.count('period'),
                            pregnancy: this.count('pregnancy')
                        },
                        money: this.monthlyMoney()
                    };
                },

                /* ---------- Phase 3F: Single Read Layer for Dashboard ----------
                   These return RAW DATA ONLY. No emoji, no BM/EN labels, no
                   currency symbol, no relative-day text. The Dashboard
                   (presentation layer) formats the output. Source of truth
                   stays in each module; StatsEngine only reads + aggregates.
                   Local-date parsing avoids UTC off-by-one. ---------------- */

                // Local YYYY-MM-DD for "today".
                _todayYMD: function () {
                    const d = new Date();
                    return d.getFullYear() + '-' +
                        String(d.getMonth() + 1).padStart(2, '0') + '-' +
                        String(d.getDate()).padStart(2, '0');
                },

                // Parse YYYY-MM-DD as LOCAL date (null if invalid).
                _parseLocalYMD: function (ymd) {
                    if (!ymd) return null;
                    const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(ymd);
                    if (!m) { const d = new Date(ymd); return isNaN(d) ? null : d; }
                    return new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
                },

                // Today's mood — raw value or null. (Most recently updated if
                // multiple for today.) Collection 'mood' -> appData.moods.
                todayMood: function () {
                    const today = this._todayYMD();
                    const todays = DataManager.get('mood')
                        .filter(function (r) { return r.entryDate === today; })
                        .sort(function (a, b) {
                            return new Date(b.updatedAt || b.createdAt) - new Date(a.updatedAt || a.createdAt);
                        });
                    return todays.length ? { mood: todays[0].mood, id: todays[0].id } : null;
                },

                // Current-month finance totals (income/expense/savings/balance)
                // as raw numbers. Uses LOCAL date + savings as its own type,
                // matching the Money module's source-of-truth logic.
                monthlyFinance: function () {
                    const now = new Date();
                    const y = now.getFullYear();
                    const m = now.getMonth();
                    let income = 0, expense = 0, savings = 0;
                    DataManager.get('money').forEach(function (r) {
                        const d = StatsEngine._parseLocalYMD(r.date) || new Date(r.createdAt);
                        if (!d || isNaN(d) || d.getFullYear() !== y || d.getMonth() !== m) return;
                        const amt = Number(r.amount) || 0;
                        if (r.type === 'income') income += amt;
                        else if (r.type === 'expense') expense += amt;
                        else if (r.type === 'savings') savings += amt;
                    });
                    return { income: income, expense: expense, savings: savings, balance: income - expense };
                },

                // Local Date for an event's start (all-day -> start of day).
                _eventDateTime: function (e) {
                    const d = this._parseLocalYMD(e.date);
                    if (!d) return null;
                    if (e.allDay || !e.startTime) return d;
                    const m = /^(\d{2}):(\d{2})$/.exec(e.startTime);
                    if (m) d.setHours(Number(m[1]), Number(m[2]), 0, 0);
                    return d;
                },

                // Active (not completed), at/after now, soonest first.
                // Raw event objects. Collection 'calendar' -> appData.events.
                // Active (not completed), at/after now, soonest first.
                // Raw event objects. Collection 'calendar' -> appData.events.
                //
                // options (all optional, backward-compatible):
                //   reminderOnly : boolean  -> only events with reminderEnabled
                //   limit        : number|null -> cap count; null/undefined = no cap
                // Sorted by date+startTime ascending (via _eventDateTime).
                // Completed and past events are always excluded.
                upcomingEvents: function (options) {
                    // Safe option normalization (klarifikasi #3): treat only
                    // an explicit finite number > 0 as a real limit; null,
                    // undefined, 0 and invalid values mean "no limit".
                    const opt = options || {};
                    const reminderOnly = opt.reminderOnly === true;
                    let limit = null;
                    if (typeof opt.limit === 'number' && isFinite(opt.limit) && opt.limit > 0) {
                        limit = Math.floor(opt.limit);
                    }

                    const now = Date.now();
                    const self = this;
                    let list = DataManager.get('calendar').filter(function (e) {
                        if (e.completed) return false;                 // exclude completed
                        if (reminderOnly && !e.reminderEnabled) return false;
                        const dt = self._eventDateTime(e);
                        return dt && dt.getTime() >= now - 60000;      // exclude past (60s grace)
                    });
                    list.sort(function (a, b) {
                        return self._eventDateTime(a) - self._eventDateTime(b);  // ascending
                    });
                    if (limit !== null) list = list.slice(0, limit);
                    return list;
                },

                // Nearest upcoming event (raw) or null. Contract unchanged
                // (klarifikasi #4): always default behaviour (reminderOnly
                // false) so the Dashboard card shows the nearest upcoming
                // event regardless of whether a reminder is enabled.
                nextUpcomingEvent: function () {
                    const up = this.upcomingEvents();
                    return up.length ? up[0] : null;
                },

                /* ---------- Phase 3G: Unified Timeline (Single Read Layer) ----
                   Merges Journal + Mood + Money + Calendar into one
                   chronological feed of NORMALIZED, RAW items. No new
                   storage; reads existing collections. The Timeline VIEW
                   formats labels/emoji/currency/BM-EN. Uses DOMAIN dates
                   (entryDate / transaction date / event date), falling
                   back to createdAt only when the domain date is missing.
                   Local time to avoid UTC off-by-one. -------------------- */

                // Build a local sort timestamp from a YMD (+ optional HH:mm).
                // Items without a time sort to the START of their day.
                _timelineTS: function (ymd, hhmm) {
                    const d = this._parseLocalYMD(ymd);
                    if (!d) return 0;
                    if (hhmm) {
                        const m = /^(\d{2}):(\d{2})$/.exec(hhmm);
                        if (m) d.setHours(Number(m[1]), Number(m[2]), 0, 0);
                    }
                    return d.getTime();
                },

                // Derive a YMD from an ISO createdAt (local) as a fallback.
                _ymdFromISO: function (iso) {
                    if (!iso) return '';
                    const d = new Date(iso);
                    if (isNaN(d)) return '';
                    return d.getFullYear() + '-' +
                        String(d.getMonth() + 1).padStart(2, '0') + '-' +
                        String(d.getDate()).padStart(2, '0');
                },

                // Produce the full normalized feed (all sources), unsorted
                // then sorted descending (most recent first). Internal.
                _timelineAll: function (sources) {
                    const want = (sources && sources.length) ? sources : ['journal', 'mood', 'money', 'calendar'];
                    const items = [];
                    const self = this;

                    if (want.indexOf('journal') !== -1) {
                        DataManager.get('journal').forEach(function (r) {
                            const date = r.entryDate || self._ymdFromISO(r.createdAt);
                            items.push({
                                source: 'journal', sourceId: r.id,
                                date: date, time: '',
                                sortTimestamp: self._timelineTS(date, ''),
                                data: { title: r.title || '', mood: r.mood || '', favorite: !!r.favorite }
                            });
                        });
                    }
                    if (want.indexOf('mood') !== -1) {
                        DataManager.get('mood').forEach(function (r) {
                            const date = r.entryDate || self._ymdFromISO(r.createdAt);
                            items.push({
                                source: 'mood', sourceId: r.id,
                                date: date, time: '',
                                sortTimestamp: self._timelineTS(date, ''),
                                data: { mood: r.mood || '', note: r.note || '' }
                            });
                        });
                    }
                    if (want.indexOf('money') !== -1) {
                        DataManager.get('money').forEach(function (r) {
                            const date = r.date || self._ymdFromISO(r.createdAt);
                            items.push({
                                source: 'money', sourceId: r.id,
                                date: date, time: '',
                                sortTimestamp: self._timelineTS(date, ''),
                                // Privacy: only type/category/amount exposed.
                                data: { type: r.type || '', category: r.category || '', amount: Number(r.amount) || 0 }
                            });
                        });
                    }
                    if (want.indexOf('calendar') !== -1) {
                        DataManager.get('calendar').forEach(function (r) {
                            const date = r.date || self._ymdFromISO(r.createdAt);
                            const time = r.allDay ? '' : (r.startTime || '');
                            items.push({
                                source: 'calendar', sourceId: r.id,
                                date: date, time: time,
                                sortTimestamp: self._timelineTS(date, time),
                                data: { title: r.title || '', category: r.category || '', allDay: !!r.allDay, startTime: r.startTime || '', completed: !!r.completed }
                            });
                        });
                    }

                    // Chronological, most recent first. Tie-break by source
                    // then id for stable ordering.
                    items.sort(function (a, b) {
                        if (b.sortTimestamp !== a.sortTimestamp) return b.sortTimestamp - a.sortTimestamp;
                        if (a.source !== b.source) return a.source < b.source ? -1 : 1;
                        return a.sourceId < b.sourceId ? 1 : -1;
                    });
                    return items;
                },

                // Public paged accessor.
                // options: { limit, offset, sources[] }
                // Returns { items, total, hasMore }.
                timeline: function (options) {
                    const opt = options || {};
                    const limit = (typeof opt.limit === 'number') ? opt.limit : 10;
                    const offset = (typeof opt.offset === 'number') ? opt.offset : 0;
                    const all = this._timelineAll(opt.sources);
                    const page = all.slice(offset, offset + limit);
                    return {
                        items: page,
                        total: all.length,
                        hasMore: (offset + limit) < all.length
                    };
                },

                /* ---------- Phase 4A: Period status (Single Read Layer) -------
                   Reads periodRecords (Source of Truth) and returns RAW status
                   for the Dashboard card / Reminder / future widgets. No
                   formatting (BM/EN handled by the View). Local dates only.
                   Prediction: >=2 records -> average gap between startDates;
                   1 record -> default 28-day cycle (predictionBasis flags it);
                   0 records -> tracking:false. Not medical advice. ---------- */
                periodStatus: function () {
                    const recs = DataManager.get('period')
                        .filter(function (r) { return r.startDate; })
                        .sort(function (a, b) {
                            // Most recent startDate first.
                            const da = StatsEngine._parseLocalYMD(a.startDate);
                            const db = StatsEngine._parseLocalYMD(b.startDate);
                            return db - da;
                        });

                    if (recs.length === 0) {
                        return { tracking: false, isPeriodActive: false, cycleDay: null,
                                 nextPredictedDate: null, daysUntilNext: null, predictionBasis: null };
                    }

                    const MS_DAY = 86400000;
                    const today = this._parseLocalYMD(this._todayYMD());
                    const last = recs[0];
                    const lastStart = this._parseLocalYMD(last.startDate);

                    // Cycle length: average gap across records if >=2, else 28.
                    let cycleLen = 28;
                    let basis = 'default28';
                    if (recs.length >= 2) {
                        let totalGap = 0, gaps = 0;
                        for (let i = 0; i < recs.length - 1; i++) {
                            const s1 = this._parseLocalYMD(recs[i].startDate);
                            const s2 = this._parseLocalYMD(recs[i + 1].startDate);
                            if (s1 && s2) { totalGap += Math.round((s1 - s2) / MS_DAY); gaps++; }
                        }
                        if (gaps > 0) { cycleLen = Math.round(totalGap / gaps); basis = 'average'; }
                    }
                    if (!cycleLen || cycleLen < 1) cycleLen = 28;

                    // Cycle day = days since last start + 1 (local).
                    let cycleDay = null;
                    if (lastStart && today) {
                        cycleDay = Math.floor((today - lastStart) / MS_DAY) + 1;
                        if (cycleDay < 1) cycleDay = null;
                    }

                    // Is a period currently active? (today within start..end,
                    // or start with no end and within a sane window.)
                    let isActive = false;
                    if (lastStart && today) {
                        const end = last.endDate ? this._parseLocalYMD(last.endDate) : null;
                        if (end) {
                            isActive = today >= lastStart && today <= end;
                        } else {
                            // No end recorded: treat as active from start for a
                            // short window (<= cycleLen), avoids "active forever".
                            const dayN = Math.floor((today - lastStart) / MS_DAY);
                            isActive = dayN >= 0 && dayN < 10; // conservative window
                        }
                    }

                    // Next predicted start = last start + cycle length.
                    let nextPredictedDate = null, daysUntilNext = null;
                    if (lastStart) {
                        const next = new Date(lastStart.getTime() + cycleLen * MS_DAY);
                        nextPredictedDate = next.getFullYear() + '-' +
                            String(next.getMonth() + 1).padStart(2, '0') + '-' +
                            String(next.getDate()).padStart(2, '0');
                        if (today) daysUntilNext = Math.round((next - today) / MS_DAY);
                    }

                    return {
                        tracking: true,
                        isPeriodActive: isActive,
                        cycleDay: cycleDay,
                        nextPredictedDate: nextPredictedDate,
                        daysUntilNext: daysUntilNext,
                        predictionBasis: basis
                    };
                }
            };

            /* =====================================================
               4) NOTIFICATION ENGINE  —  one system, all modules
               ===================================================== */
            // In-app notifications only (NOT browser push). These now
            // persist in appData.notifications so they survive refresh,
            // export and import — via the existing saveDataToLocal().
            const NotificationEngine = {
                _listeners: [],

                // Backing store = the persisted array on appData.
                _store: function () {
                    if (!Array.isArray(appData.notifications)) {
                        appData.notifications = [];
                    }
                    return appData.notifications;
                },

                // Register a callback fired whenever notifications change.
                subscribe: function (fn) {
                    if (typeof fn === 'function') this._listeners.push(fn);
                },

                _emit: function () {
                    const snapshot = this._store().slice();
                    this._listeners.forEach(function (fn) {
                        try { fn(snapshot); } catch (e) { /* listener isolation */ }
                    });
                },

                // Push a notification. source = module name, e.g. 'reminder'.
                notify: function (source, message, meta) {
                    const n = {
                        id: makeId(),
                        source: source,
                        message: message,
                        meta: meta || {},
                        createdAt: nowISO(),
                        read: false
                    };
                    this._store().push(n);
                    saveDataToLocal();
                    this._emit();
                    return n;
                },

                getAll: function () { return this._store().slice(); },

                getUnread: function () {
                    return this._store().filter(function (n) { return !n.read; });
                },

                markRead: function (id) {
                    const n = this._store().find(function (x) { return x.id === id; });
                    if (n) { n.read = true; saveDataToLocal(); this._emit(); }
                },

                clear: function () {
                    appData.notifications = [];
                    saveDataToLocal();
                    this._emit();
                },

                // Scan date-based collections for anything due now/overdue.
                // Modules with a { dueDate } field get checked automatically.
                scanDue: function () {
                    const due = [];
                    const now = Date.now();
                    ['reminder', 'calendar', 'pregnancy', 'period'].forEach(function (name) {
                        ensureCollection(name).forEach(function (r) {
                            const raw = r.dueDate || r.date;
                            if (!raw) return;
                            const t = new Date(raw).getTime();
                            if (!isNaN(t) && t <= now && !r._notified) {
                                due.push({ collection: name, item: r });
                            }
                        });
                    });
                    return due;
                }
            };

            /* =====================================================
               5) THEME ENGINE  —  central palette, no per-module CSS
               ===================================================== */
