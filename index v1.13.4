    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        app: {
                            /* --- Semantic ROLE aliases (preferred, theme-agnostic
                               names). Use these for UI state so code reads
                               correctly under any theme (Ocean, Mocha, etc). --- */
                            primary: 'rgb(var(--primary) / <alpha-value>)',
                            'primary-dark': 'rgb(var(--primary-dark) / <alpha-value>)',
                            'primary-soft': 'rgb(var(--primary-soft) / <alpha-value>)',
                            border: 'rgb(var(--border) / <alpha-value>)',
                            /* --- Legacy colour-named aliases (kept for backward
                               compatibility; identical targets). --- */
                            cream: 'rgb(var(--bg-primary) / <alpha-value>)',
                            blush: 'rgb(var(--primary-soft) / <alpha-value>)',
                            rose: 'rgb(var(--primary) / <alpha-value>)',
                            'rose-dark': 'rgb(var(--primary-dark) / <alpha-value>)',
                            beige: 'rgb(var(--border) / <alpha-value>)',
                            gold: 'rgb(var(--accent) / <alpha-value>)',
                            accent: 'rgb(var(--accent) / <alpha-value>)',
                            text: 'rgb(var(--text-secondary) / <alpha-value>)',
                            dark: 'rgb(var(--text-primary) / <alpha-value>)',
                            light: '#FFFFFF',
                            /* Neutral tones (dynamic, general UI accents) */
                            sage: 'rgb(var(--tone-sage) / <alpha-value>)',
                            lavender: 'rgb(var(--tone-lavender) / <alpha-value>)',
                            green: 'rgb(var(--tone-green) / <alpha-value>)',
                            blue: 'rgb(var(--tone-blue) / <alpha-value>)',
                            /* Category colour — semantic, FIXED across themes */
                            coral: '#E5989B'
                        }
                    }
                }
            }
